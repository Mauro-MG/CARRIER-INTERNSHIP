rule "manufacturing.panel.v2.drawings.doorframe.c.channel.v.screw.corner.20170909.01"
when
     drawing matches "panel.v2.flat.c.v"
>    ManufacturingFeature(  name ==  "feature.doorframe",  doorBound : value,    pparent: parent)
>                RuleLink( ln:  name matches "drawingToParentFlat.doorframe.c.v",  a == drawing,  b == pparent )

>    ManufacturingFeature(  name ==  "general.doorframe.b.cornerhole", screwFirst: doubleValue,    parent == pparent)

then
