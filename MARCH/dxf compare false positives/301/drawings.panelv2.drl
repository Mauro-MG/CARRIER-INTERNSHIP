>     flat.addCircle(new Point3d(offset.x + hx2                   , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2]-partsd[Y3]-partsd[Y4] ,0) , RADIUS,why);



>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();
