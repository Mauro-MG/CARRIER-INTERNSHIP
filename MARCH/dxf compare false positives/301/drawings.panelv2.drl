// TEST PORT RULE OUTSIDE PANEL (Duro Dyne)
// Reference drawing: 39MA40052400, Rev: V.2

rule "manufacturing.panel.v2.drawings.testport.flanged.20250125.01"
when
     drawing matches "panel.v2.(outswing.door.flat.outside|flat.outside|inswing.door.flat.noflange)"
>    ManufacturingFeature(  cn: name matches "feature.testport",  bounds: value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.*",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)

then
>   Point3d center = BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds));
>   String why = drools.getRule().getName();
>   // add a dimple to ensure the two flats are assembled correctly.
>   Point3d dimple = new Point3d(3.35, .1, 0);
>   // change it for inswing
>   Point3d centerhandle = new Point3d(center.x + 0.920, center.y, center.z);
>   final double RADIUS = 1.350*.5;
>   final double RADIUSHANDLE = 0.296*.5;
>   transformsPoint( (Transform3D[]) transformO, center);
>   transformsPoint( (Transform3D[]) transformO, centerhandle);
>   drawing.addCircle(center , RADIUS ,why);
>   drawing.addCircle(centerhandle, RADIUSHANDLE ,why);
>   String pt = formatXYStr(drawing, center);
>   insert(new QualityEntry(pparent, "TESTPORT1", pt,200));
>   insert(new QualityEntry(pparent, "STATIC", "["+ "39MA50000128" + "  QTY" + "1" +"]" ,1000));
>   insert(new QualityEntry(pparent, "STATIC", "["+ "39MA50000127" + "  QTY" + "1" +"]" ,1000));
end

// TEST PORT RULE OUTSIDE PANEL (Allegis)

rule "manufacturing.panel.v2.drawings.testport2.flanged.20250728.01"
when
drawing matches "panel.v2.(outswing.door.flat.outside|flat.outside|inswing.door.flat.noflange)"
        >    ManufacturingFeature(  cn: name matches "feature.testport2",  bounds: value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.*",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)

then
>   Point3d center = BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds));
>   String why = drools.getRule().getName();
>   // add a dimple to ensure the two flats are assembled correctly.
>   Point3d dimple = new Point3d(3.35, .1, 0);
>   // change it for inswing
>   Point3d centerhandle = new Point3d(center.x + 0.920, center.y, center.z);
>   Point3d centerTP1 = new Point3d(center.x - 0.758, center.y + 0.438, center.z);
>   Point3d centerTP2 = new Point3d(center.x, center.y - 0.876, center.z);
>   Point3d centerTP3 = new Point3d(center.x + 0.758, center.y + 0.438, center.z);
>   final double hexagoneinDiameter = 0.281;
>   final double RADIUS = 1.0 * .5;
>   final double RADIUSHANDLE = 0.296*.5;
>   transformsPoint( (Transform3D[]) transformO, center);
>   transformsPoint( (Transform3D[]) transformO, centerhandle);
>   transformsPoint( (Transform3D[]) transformO, centerTP1);
>   transformsPoint( (Transform3D[]) transformO, centerTP2);
>   transformsPoint( (Transform3D[]) transformO, centerTP3);
>   drawing.addCircle(center , RADIUS ,why);
>   drawHexagone(drawing, centerTP1, hexagoneinDiameter, why);
>   drawHexagone(drawing, centerTP2, hexagoneinDiameter, why);
>   drawHexagone(drawing, centerTP3, hexagoneinDiameter, why);
>   String pt = formatXYStr(drawing, center);
>   insert(new QualityEntry(pparent, "TESTPORT2", pt,200));
>   insert(new QualityEntry(pparent, "STATIC", "["+ "39MA50119002" + "  QTY" + "1" +"]" ,1000));
>   insert(new QualityEntry(pparent, "STATIC", "["+ "39MA50119001" + "  QTY" + "1" +"]" ,1000));
end

// second rule for minihelic
// this has two pipe holes, two screw holes and 1-3 dimples.
rule "manufacturing.panel.v2.drawings.minihelic.nonflanged.20201027.01"
when
     drawing matches "panel.v2.(outswing.door.flat.inside|flat.inside|inswing.door.flat.flange)"
>    ManufacturingFeature(  cn: name matches "feature.minihelic.*",  bounds: value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.*",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
>    ManufacturingFeature(  name ==  "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.dim.b.axis",  bAxis: value,    parent == pparent)

then

> // asserts
>   if (!aAxis.equalsIgnoreCase("X")) {
>      throw new Exception(cn + " on panel with a axis not X " + aAxis);
>   }
>   if (!bAxis.equalsIgnoreCase("Y")) {
>      throw new Exception(cn + " on panel with b axis not Y " + aAxis);
>   }


>   final double RADIUSTUBE = 0.50*.5;
>   final double RADIUSSCREW = 0.19*.5;
>   final double DIMPLEXY = 0.8;
>   final double SCREWX = 1.17;
>   final double PIPEY = 1;

>   Point3d center = BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds));
>   Point3d centerRaw = new Point3d(center);
>   Point3d centerScrewL = new Point3d(center);
>   centerScrewL.x -= SCREWX;
>   Point3d centerScrewU = new Point3d(center);
>   centerScrewU.x += SCREWX;
>   Point3d centerMinusPipeY = new Point3d(center);
>   centerMinusPipeY.y -=  PIPEY;
>   Point3d dimpleCenter = new Point3d(center);
>   dimpleCenter.y +=   DIMPLEXY;
>   double dimpleXOffset = (cn.substring(17,18).equals("2")) ? DIMPLEXY*.5 : DIMPLEXY;
>   Point3d dimpleL = new Point3d(dimpleCenter);
>   dimpleL.x -=  dimpleXOffset;
>   Point3d dimpleU = new Point3d(dimpleCenter);
>   dimpleU.x +=  dimpleXOffset;

>   transformsPoint( (Transform3D[]) transformO, center);
>   transformsPoint( (Transform3D[]) transformO, centerMinusPipeY);
>   transformsPoint( (Transform3D[]) transformO, centerScrewL);
>   transformsPoint( (Transform3D[]) transformO, centerScrewU);
>   transformsPoint( (Transform3D[]) transformO, dimpleCenter);
>   transformsPoint( (Transform3D[]) transformO, dimpleL);
>   transformsPoint( (Transform3D[]) transformO, dimpleU);

>   String why = drools.getRule().getName();

>   // add a dimple to ensure the two flats are assembled correctly.
>   boolean inswingDoor = drawingName.contains("inswing");
>   Point3d dimple = new Point3d(.6, .1 , 0);
>   if (inswingDoor) {
>     dimple.x = 3.35;
>   }
>   drawDimple(dimple, drawing, why);

> // draw the pipe holes, one centered, one with a y offset = PIPEY * yScale
>   drawing.addCircle(center              , RADIUSTUBE,why);
>   drawing.addCircle(centerMinusPipeY    , RADIUSTUBE,why);
> // draw the screw holes, each SCREWX from center
>   drawing.addCircle(centerScrewL  , RADIUSSCREW,why);
>   drawing.addCircle(centerScrewU  , RADIUSSCREW,why);

>   // 1 to 3 dimples
>   if (cn.substring(17,18).equals("1")) {
>     drawDimple(dimpleCenter, drawing, why);
>   } else if (cn.substring(17,18).equals("2")) {
>     drawDimple(dimpleL, drawing, why);
>     drawDimple(dimpleU, drawing, why);
>   } else if (cn.substring(17,18).equals("3")) {
>     drawDimple(dimpleCenter, drawing, why);
>     drawDimple(dimpleL, drawing, why);
>     drawDimple(dimpleU, drawing, why);
>   } else {
>     throw new Exception("unknown minihelic number " + cn);
>   }
    
end


