function int getAxisNdx(String axis) {
  if (axis.equalsIgnoreCase("X")) {
    return 0;
  } else if (axis.equalsIgnoreCase("Y")) {
    return 1;
  } else if (axis.equalsIgnoreCase("Z")) {
    return 2;
  } else {
    throw new Exception("Unknown axis A X Y but sent " + axis);
  }
}

function void transformsPoint(Transform3D[] transforms, Point3d point) {
  for (Transform3D t : transforms) {
     t.transform(point);
  } 
}
function void transformsBoundingBox(Transform3D[] transforms, BoundingBox b) {
  for (Transform3D t : transforms) {
     b.transform(t);
  } 
}

//Function to drawn hexagones
function void drawHexagone(Drawing drawing, Point3d center, double inDiameter, String why) {

    Point3d Vertex1 = new Point3d(center.x - (Math.tan(Math.toRadians(30)) * (inDiameter/2)), center.y + (inDiameter/2), center.z);
    Point3d Vertex2 = new Point3d(center.x + (Math.tan(Math.toRadians(30)) * (inDiameter/2)), center.y + (inDiameter/2), center.z);
    Point3d Vertex3 = new Point3d(center.x + (inDiameter / (2 * Math.cos(Math.toRadians(30)))), center.y, center.z);
    Point3d Vertex4 = new Point3d(center.x + (Math.tan(Math.toRadians(30)) * (inDiameter/2)), center.y - (inDiameter/2), center.z);
    Point3d Vertex5 = new Point3d(center.x - (Math.tan(Math.toRadians(30)) * (inDiameter/2)), center.y - (inDiameter/2), center.z);
    Point3d Vertex6 = new Point3d(center.x - (inDiameter / (2 * Math.cos(Math.toRadians(30)))), center.y, center.z);
    
    drawing.addLine(Vertex1, Vertex2, why);
    drawing.addLine(Vertex2, Vertex3, why);
    drawing.addLine(Vertex3, Vertex4, why);
    drawing.addLine(Vertex4, Vertex5, why);
    drawing.addLine(Vertex5, Vertex6, why);
    drawing.addLine(Vertex6, Vertex1, why);
    
}


