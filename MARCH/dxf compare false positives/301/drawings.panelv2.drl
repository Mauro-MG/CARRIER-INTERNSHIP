// dimple function used in multiple places

function void drawDimple(Point3d center, Drawing drawing, String why) {
   final double SHORT = .02 / 2.0;
   final double LONG  = .1 / 2.0; 

   Point3d one = new Point3d(center.x, center.y + SHORT, center.z);
   Point3d p = new Point3d(center.x + LONG, center.y + LONG, center.z);
   drawing.addLine(one, p, why); // 1 to 2
   drawing.addLineRelative( new Point3d(SHORT- LONG, -LONG, 0), why ); // 2 to 3
   drawing.addLineRelative( new Point3d(LONG- SHORT, -LONG, 0), why ); // 3 to 4
   drawing.addLineRelative( new Point3d(-LONG, LONG-SHORT, 0), why ); // 4 to 5
   drawing.addLineRelative( new Point3d(-LONG, SHORT-LONG, 0), why ); // 5 to 6
   drawing.addLineRelative( new Point3d(LONG- SHORT, LONG, 0), why ); // 6 to 7
   drawing.addLineRelative( new Point3d(SHORT-LONG, LONG, 0), why ); // 7 to 8
   drawing.addLineRelative( new Point3d(LONG, SHORT-LONG, 0), why ); // 8 to 1
}


function String makeConduitName(double d) {
     int diameter = (int) Math.floor(d);
     return "CONDUIT_" + diameter + "_" + (Math.round((d - diameter) *100));
}

//in multiple files !!!
function String getOptionalManufacturingFeature(ManufacturedItem mi, String name, boolean incrementUsage) {
    ManufacturingFeature mf = mi.getOptionalFeature(name);
    if (mf != null) {
      mf.incrementUsage();
      return mf.getValue();
    } else {
      return "";
    }
}

// caution on booleans - easy to mix up sequence
// gaugeA is non flange = red
// gaugeB is flanged = blue
// move constants to properties?

function void growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor) {
  // where adjustment occurs on flat, distance from flat extents
  final double OFFSETREDNONFLANGETB =  .15;
  final double OFFSETREDNONFLANGENTB = .3 ;
  final double OFFSETREDFLANGE = .3425;
  final double OFFSETBLUEFLANGE = 1.6255;
  final double OFFSETBLUE90 = .15; // just needs to be beyond the border

  // how much to adjust
  //final double RED18G = 0.02;
  //final double RED14G = 0.025;
  final double BLUENOSPACER = 0.014;
  final double BLUEDIAMOND = -0.02; // per PPT sent from TMP 2018 Jun 12
  final double BLUESPACER = 0.055;
  final double BLUESPACEROUTSWINGDOOR = 0.008;

  if (isNonFlange) { // gaugeA
     double adjust = RuleHelper.pairMatchd(";14;.025;18;.02;.*;0", gaugeA); //RED14G , RED18G
     double red = OFFSETREDNONFLANGENTB;
     if (isTb) {
       red = OFFSETREDNONFLANGETB; 
     }
     growFlat(d, red, 0, adjust, 0);
  } else { // flange
     if (gaugeB.equals("0.045")) { //Diamond Tread Plate
        growFlat(d, OFFSETBLUE90, 0, BLUEDIAMOND, 0);
     } else if (gaugeB.equals("18") ) {
        double adjust = BLUENOSPACER;
        if (hasSpacer) {
          adjust = BLUESPACER;
          if (isOutswingDoor) {
            adjust = BLUESPACEROUTSWINGDOOR;
          }
        }
        growFlat(d, OFFSETREDFLANGE, OFFSETBLUEFLANGE, 0, adjust);
     }
  }
}


function void growFlat(Drawing d, double sfm90, double sfm180, double shiftFor90, double shiftFor180) {
  // assumes but does not assert sfm90 is less than sfm180
  
  // only do the work if we have to shift something
  boolean shiftRequired90 = (Math.abs(shiftFor90) > .0001);
  boolean shiftRequired180 = (Math.abs(shiftFor180) > .0001);


  if (shiftRequired90 || shiftRequired180) { //shift happens
    // get flat extents
    Point3d maxExtent = d.getMaximumExtent();
    Point3d minExtent = d.getMinimumExtent();
    
    double lastShift = 0;

    double shiftX[] = { maxExtent.x - sfm180             , shiftFor180,
                        maxExtent.x - sfm90 + shiftFor180,  shiftFor90,
                        minExtent.x + sfm180             , shiftFor180,
                        minExtent.x + sfm180             , shiftFor90,
                      };
 
    double shiftY[] = { maxExtent.y - sfm180             , shiftFor180,
                        maxExtent.y - sfm90 + shiftFor180, shiftFor90,
                        minExtent.y + sfm180             , shiftFor180,
                        minExtent.y + sfm90              , shiftFor90,
                      };

    for (int x = 0; x < shiftX.length;x += 2) {
      if (Math.abs(shiftX[x+1]) > .0001) { 
        d.alterDimensionX(shiftX[x+1],  shiftX[x], Double.POSITIVE_INFINITY);
      }
    }
    for (int x = 0; x < shiftY.length;x += 2) {
      if (Math.abs(shiftY[x+1]) > .0001) { 
        d.alterDimensionY(shiftY[x+1],  shiftY[x], Double.POSITIVE_INFINITY);
      }
    }
  } // something to shift

}


function boolean needToGrowFlat(String gaugeA, String gaugeB) {
  return (gaugeA.equals("14") || gaugeA.equals("18") || gaugeB.equals("14") || gaugeB.equals("18") || gaugeB.equals("0.045")) ;
}

function boolean hasSpacer(ManufacturedItem mi) {
  String spacer = getOptionalManufacturingFeature(mi, "general.flange.spacer", true);
  return spacer.equals("YES") ;
}

function String getA2lClassification(ManufacturedItem mi) {
    String mfValue = getOptionalManufacturingFeature(mi, "general.classification.A2L", false);
    // If the item doesn't have "general.classification.A2L" at all, default to NO as a value
    if (mfValue.equals("")) {
        mfValue = "NO";
    }
    return mfValue;
}

function String getGauge(ManufacturedItem mi, boolean isA) {
  String retValue = "";
  if (isA) {
     retValue = getOptionalManufacturingFeature(mi, "general.gauge.a", true); // get gauge, if we have them
  } else {
     retValue = getOptionalManufacturingFeature(mi, "general.gauge.b", true); // get gauge, if we have them
  }
  return retValue;
}

function Drawing createSpacerFlat(String drawingName, double tipToTip, int holeCount, double holeSpacing, String why, String filename) {
   Drawing d = new Drawing(drawingName);
   d.createDefaultDrawing();
   d.setOutputFilename(filename, why);
   final double TIPTOTIPHALF = 0.12;
   double length = tipToTip - (TIPTOTIPHALF*2.0);
   // make perimeter
   d.addLine(new Point3d(0,0,0), new Point3d(length,0,0), why);
   d.addLine(new Point3d(length -1, 1,0), why);
   d.addLine(new Point3d(1, 1,0), why);
   d.addLine(new Point3d(0, 0,0), why);
   // add holes
   if (holeCount > 0) {
     double patternLength = holeSpacing * (holeCount -1.0);
     final double SINGLEOFFSET = .795 - TIPTOTIPHALF;
     double offset = (holeCount != 1) ? (length - patternLength) *.5 :  holeSpacing + SINGLEOFFSET   ;
     Point3d circle = new Point3d(offset, .316,0);
     final double radius = 0.625 *.5;
     for (int x = 1; x <= holeCount; x++) {
       d.addCircle(circle, radius, why);
       circle.x += holeSpacing;
     }
   }
   d.generate(why); 
   return d;
}


//  ensure boundingbox is created with min(a,b) to max(a,b)
function BoundingBox createBoundsFromLine(Point3d origin, Point3d a, Point3d b) {
   double ad = origin.distance(a);
   double bd = origin.distance(b);
   if (ad <= bd) {
     return new BoundingBox(a,b);
   } else {
     return new BoundingBox(b,a);
   }
}

// we are extending the drawing template to do arcs - since this is external - we need to replicate a lot of the internal implementation
function List generateArcEntities(Drawing d, Point3d center, double radius, double startAngle, double stopAngle, String message) {

    // caution - transforms with rotations will not work here since the arc angle is not adjusted

     List results = new ArrayList();
   //  results.add(dxfAddComment(message));

     DrawingState ds = d.getState();
     String layer = ds.getCurrentLayer();
     String color = ds.getColor();
     // this breaks a lot of internal implementation details
     String handle = "fff"; // ensure we reset handles before generation // Integer.toHexString(++(d.handleCount));
     String lineType = ds.getLineType();
     int roundPlaces = ds.getRoundPlaces();

     transformPoint(d, center);
     double centerx = DrawingState.round(center.x, roundPlaces);
     double centery = DrawingState.round(center.y, roundPlaces);
     double rad = DrawingState.round(radius, roundPlaces);
     double startA = DrawingState.round(startAngle, roundPlaces);
     double stopA = DrawingState.round(stopAngle, roundPlaces);


/*
  0
ARC
  8
0
 62
7
  6
CONTINUOUS
 10
2.7275830925
 20
0.2275877521
 40
0.125
 50
180.0
 51
270.0
*/
        final String LINE_TYPE_CODE = "6";
        final String RADIUS_CODE = "40";
        final String COLOR_CODE = "62";

        final String START_ANGLE_CODE = "50";
        final String STOP_ANGLE_CODE = "51";

        //List<DxfEntry> results = new ArrayList<DxfEntry>();
        results.add(new DxfEntry(DxfPrimitives.NEW_OBJECT_CODE, "ARC"));
        results.add(new DxfEntry(DxfPrimitives.HANDLE_CODE, handle));
        results.add(new DxfEntry(DxfPrimitives.LAYER_CODE, layer));
        results.add(new DxfEntry("100", "AcDbEntity"));
        results.add(new DxfEntry("100", "AcDbArc"));
        results.add(new DxfEntry(LINE_TYPE_CODE, lineType));
        results.add(new DxfEntry(DxfPrimitives.X1_CODE, Double.toString(centerx)));
        results.add(new DxfEntry(DxfPrimitives.Y1_CODE, Double.toString(centery)));
        results.add(new DxfEntry(DxfPrimitives.Z1_CODE, "0"));
        results.add(new DxfEntry(RADIUS_CODE, Double.toString(rad)));
        results.add(new DxfEntry(COLOR_CODE, color));
        results.add(new DxfEntry(START_ANGLE_CODE, Double.toString(startA)));
        results.add(new DxfEntry(STOP_ANGLE_CODE, Double.toString(stopA)));

        return results;

}

function List dxfAddComment(String text) {
     text = text.replace("(\n|\r)", " ");
     List results = new ArrayList();
     results.add(new DxfEntry(DxfPrimitives.COMMENT, text));
     return results;
}


function void transformPoint(Drawing d, Point3d p) {
     d.getState().transform(p);
}

//  flat offset
//  
function Transform3D[] calculateTransformAlt(String aAxis, String bAxis, String nonAxis, String relativeLocation, Drawing d, BoundingBox panelBounds, boolean flipX, boolean flipY) {
   
   Transform3D results[];
   int resultLength =  (flipX || flipY) ? 2 : 1;
   results =  new Transform3D[resultLength];
   results[0] = new Transform3D();


   boolean faces[] = { false, false, false, false, false, false };
// enums not allowed here
   final int INLET=0;
   final int OUTLET=1;
   final int BOTTOM=2;
   final int TOP=3;
   final int SIDEOPPOSITE=4;
   final int SIDETHIS=5;

   faces[INLET] = ( nonAxis.equalsIgnoreCase("X") &&  relativeLocation.equalsIgnoreCase("L") );
   faces[OUTLET] = ( nonAxis.equalsIgnoreCase("X") &&  relativeLocation.equalsIgnoreCase("U") );
   faces[BOTTOM] = ( nonAxis.equalsIgnoreCase("Y")  &&  relativeLocation.equalsIgnoreCase("L") );
   faces[TOP] = ( nonAxis.equalsIgnoreCase("Y")  &&  relativeLocation.equalsIgnoreCase("U") );
   faces[SIDEOPPOSITE] = ( nonAxis.equalsIgnoreCase("Z") &&  relativeLocation.equalsIgnoreCase("L") );
   faces[SIDETHIS] = ( nonAxis.equalsIgnoreCase("Z") &&  relativeLocation.equalsIgnoreCase("U"));

   int hits = 0;
   for (int ndx=0; ndx < faces.length; ndx++)  {
     if (faces[ndx]) { hits++; }
   }
   if (hits != 1) {
     throw new Exception("Could not determine panel face [" + aAxis + bAxis + nonAxis + relativeLocation+ "]");
   }

   Point3d maxExtent = d.getMaximumExtent();
   Point3d minExtent = d.getMinimumExtent();
   Point3d flatExtent = new Point3d(maxExtent);
   flatExtent.sub(minExtent);
 
   Matrix4d m = new Matrix4d();
   results[0].get(m);

   Point3d panelL = new Point3d();
   Point3d panelExtent = new Point3d();
   panelBounds.getLower(panelL);
   panelBounds.getUpper(panelExtent);
   panelExtent.sub(panelL);


   // wipe out Z
   m.m22=0; // z = 0 after transform
   
   if (faces[INLET]) {
     // inlet:  
     //   B dim =  unit z = -flat y
     m.m12 = -m.m11;
     m.m11 = 0;
     //   A dim = unit Y = flat x
     m.m01 = m.m00;
     m.m00 = 0;

     // leave unit z as is, ignored
     m.m03 = (flatExtent.x-panelExtent.y)*.5 - panelL.y;
     m.m13 = (flatExtent.y-panelExtent.z)*.5 + panelExtent.z + panelL.z;
   
   } else if (faces[OUTLET]) {
     // outlet:  
     //   B dim =  unit z = flat y
     m.m12 = m.m11; 
     m.m11 = 0;
     //   A dim = unit Y = flat x
     m.m01 = m.m00; 
     m.m00 = 0;
     // leave unit z as is, ignored
     m.m03 = (flatExtent.x-panelExtent.y)*.5 - panelL.y;
     m.m13 = (flatExtent.y-panelExtent.z)*.5 - panelL.z;
   } else if (faces[SIDETHIS]) {
    // right side
    //  A dim = unit x = flat x
    //  B dim = unit y = flat y
     m.m03 = (flatExtent.x-panelExtent.x)*.5 - panelL.x;
     m.m13 = (flatExtent.y-panelExtent.y)*.5 - panelL.y;
   } else if (faces[SIDEOPPOSITE]) {
    // right side
    //  A dim = unit x = -flat x
     m.m00 = -m.m00; 
    //  B dim = unit y = flat y
     m.m03 = (flatExtent.x-panelExtent.x)*.5 + panelExtent.x + panelL.x;
     m.m13 = (flatExtent.y-panelExtent.y)*.5 - panelL.y;
   } else if (faces[TOP] || faces[BOTTOM]) {
   // top bottom
     //   A dim =  unit x = flat x
     //   B dim =  unit z = -flat y  (lz is at +y of flat)
     m.m12 = -m.m11;
     m.m11 = 0;
     m.m03 = (flatExtent.x-panelExtent.x)*.5 - panelL.x;
     m.m13 = (flatExtent.y-panelExtent.z)*.5 + panelExtent.z + panelL.z;
   }
   results[0].set(m);


   if (flipX || flipY) {
     // easier to debug than array multiplication
     results[1] = new Transform3D();
     results[1].get(m);

     if (flipX) {
       m.m00 = -1;
       m.m03 = flatExtent.x;
     }
     if (flipY) {
       m.m11 = -1;
       m.m13 = flatExtent.y;
     }
     results[1].set(m);
   }
   return results;
}


function Point3d calculateFeatureOffset(String aAxis, String bAxis, Point3d featureCenter, Point3d panelCenter, Drawing flat) {
    Point3d flatLow = flat.getMinimumExtent();
    Point3d flatCenter = flat.getMaximumExtent();
    flatCenter.sub(flatLow);
    flatCenter.scaleAdd(.5, flatLow);
    System.out.println("Flat center = " + flatCenter);
    
    Point3d offset = new Point3d();

    if (aAxis.equalsIgnoreCase("X")) {
       offset.x = featureCenter.x - panelCenter.x + flatCenter.x;
    } else if (aAxis.equalsIgnoreCase("Y")) {
       offset.x = featureCenter.y - panelCenter.y + flatCenter.y;		
    } else if (aAxis.equalsIgnoreCase("Z")) {
       offset.x = featureCenter.z - panelCenter.z + flatCenter.z;
    } else {
 	throw new Exception("unable to determine general.dim.a.axis " + aAxis);
    }
    if (bAxis.equalsIgnoreCase("X")) {
       offset.y = featureCenter.x - panelCenter.x + flatCenter.x;
    } else if (bAxis.equalsIgnoreCase("Y")) {
       offset.y = featureCenter.y - panelCenter.y + flatCenter.y;		
    } else if (bAxis.equalsIgnoreCase("Z")) {
       offset.y = featureCenter.z - panelCenter.z + flatCenter.z; 
    } else {
 	throw new Exception("unable to determine general.dim.b.axis " + bAxis);
    }
    return offset;
}

// Added this function to minimize testing for terminal strip box location
// 
function Point3d calculateFeatureOffsetAlternate(String aAxis, String bAxis, Point3d featureCenter, Point3d panelCenter, Drawing flat) {
    Point3d flatLow = flat.getMinimumExtent();
    Point3d flatCenter = flat.getMaximumExtent();
    flatCenter.sub(flatLow);
    flatCenter.scaleAdd(.5, flatLow);
    System.out.println("Flat center = " + flatCenter);
    
    Point3d offset = new Point3d();

    if (aAxis.equalsIgnoreCase("X")) {
       offset.x = featureCenter.x - panelCenter.x + flatCenter.x;
    } else if (aAxis.equalsIgnoreCase("Y")) {
       offset.x = featureCenter.y - panelCenter.y + flatCenter.x;		
    } else if (aAxis.equalsIgnoreCase("Z")) {
       offset.x = featureCenter.z - panelCenter.z + flatCenter.z;
    } else {
 	throw new Exception("unable to determine general.dim.a.axis " + aAxis);
    }
    if (bAxis.equalsIgnoreCase("X")) {
       offset.y = featureCenter.x - panelCenter.x + flatCenter.x;
    } else if (bAxis.equalsIgnoreCase("Y")) {
       offset.y = featureCenter.y - panelCenter.y + flatCenter.y;		
    } else if (bAxis.equalsIgnoreCase("Z")) {
       offset.y = featureCenter.z - panelCenter.z + flatCenter.y; // changed from flatCenter.z on September 10 2010
    } else {
 	throw new Exception("unable to determine general.dim.b.axis " + bAxis);
    }
    return offset;
}

//  caution - shared with other drl - changes to body need to be made in all drl files
    function Point3d center(BoundingBox b) {
        Point3d l = new Point3d();
        Point3d u = new Point3d();
        b.getLower(l);
        b.getUpper(u);
        u.sub(l);
        u.scale(.5);
        l.add(u);
        return l;
    }

function boolean invertY(String aAxis, String bAxis) {
  // yes for top and bottom
  return (aAxis.equals("X") && bAxis.equals("Z"));
}

function boolean invertX(String aAxis, String bAxis, String orientation) {
  // yes for left
  return (aAxis.equals("X") && bAxis.equals("Y") && !orientation.equals("STANDARD"));
}

    // make 4 perf channels withing bounds b
    function List makeLinesV2(BoundingBox b) {
        final double THICKNESS = 1.01; // height of channel
        final double WIDTH = 1.25; // width of channel

        List<BoundingBox> results = new ArrayList<BoundingBox>();
        Point3d l = new Point3d();
        Point3d u = new Point3d();
        b.getLower(l);
        b.getUpper(u);
        results.add(new BoundingBox(l, new Point3d(l.x + WIDTH, u.y, THICKNESS))); //lower left to upper left
        results.add(new BoundingBox(new Point3d(l.x, u.y - WIDTH, 0), u)); // upper left to upper right
        results.add(new BoundingBox(l, new Point3d(u.x, l.y + WIDTH, THICKNESS))); //lower left to lower right
        results.add(new BoundingBox(new Point3d(u.x - WIDTH, l.y, 0), new Point3d(u.x, u.y, THICKNESS))); // lower right to upper right

        return results;
    }


    function double[] perfPattern(double length) {
        final double FIRSTHOLE = 2;
        final double SPACING = 12;
        double spaceBetweenEnds = length - (FIRSTHOLE * 2.0);
        int holeCount = ((int) Math.ceil(spaceBetweenEnds / SPACING) + 1);
        double holeSpacing = spaceBetweenEnds / (holeCount - 1.0);
        double hx = FIRSTHOLE;
        double[] results = new double[holeCount];
        for (int h = 0; h < holeCount; h++) {
            results[h] = hx;
            hx += holeSpacing;
        }
        return results;
    }



function String formatXYStr(Drawing d, Point3d center) {
   Point3d origin = d.getFeature("ORG_ANC_LL").getHandle();
   return "X=" + Rounding.roundToPrettyString(center.x - origin.x, 3) + "  Y=" + Rounding.roundToPrettyString(center.y-origin.y, 3);
}

function String qCFormatXY(Drawing d, Point3d center) {
    if (d.getDrawingName().contains("outside")) {
      return formatXYStr(d, center);
    } else {
      return null;
    }
}




function double getPointByNdx(Point3d p, int ndx) {
  if (ndx==0) {
    return p.x;
  } else if (ndx==1) {
    return p.y;
  } else if (ndx==2) {
    return p.z;
  } else {
    throw new Exception("Unknown get index for point 0-2 but sent " + ndx);
  }
}

