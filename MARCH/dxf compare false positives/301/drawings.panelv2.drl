// I think this leaks flats for doors



rule "manufacturing.panel.v2.shared.constants.20090612.01"
when
then
>     // This rule should not be here. It should be moved to the general rules
>     // I put it here to get production drawings out quickly

>   final double FLANGED_OPENING_TO_PANEL_DIM_ADJUSTMENT = 2.19;  // Distance between the 03-61 A value and the tip to tip distance of a 
>   final double DOOR_TIP_X = 1.306;  // extracted from the inswing door qc 
>   final double DOOR_TIP_Y = 2.222;  //   ditto - this should match FLANGED_OPENING_TO_PANEL_DIM_ADJUSTMENT

>   insert(new RuleFlag("PANELV2.FLANGED.TIP.OFFSET", FLANGED_OPENING_TO_PANEL_DIM_ADJUSTMENT));
>   insert(new RuleFlag("PANELV2.FLANGED.TIP.DOOR.X.OFFSET", DOOR_TIP_X));
>   insert(new RuleFlag("PANELV2.FLANGED.TIP.DOOR.Y.OFFSET", DOOR_TIP_Y));
end




// Add all panels to drawing list
rule "manufacturing.panel.v2.drawings.generate.list.20090502"
when
>                              RuleLink( name == "LIST.DRAWINGS.ALL", listO: a)
>                              RuleLink( name == "LIST.DRAWINGS.PARTNUMBER", listP: a)
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )
then
>    List<String> parts = (List<String>) listP;
>    if (!parts.contains(pparent.getPartNumber())) {
>       List<ManufacturedItem> drawings = (List<ManufacturedItem>) listO;
>       drawings.add(pparent);
>       parts.add(pparent.getPartNumber());
>    }
>
end


// Standard Panel (Tb and NTB)
rule "manufacturing.panel.v2.a2l.panel.channel.drawings.20201024.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )
>    mi:           ManufacturedItem( this == pparent, part : partNumber)
>                  not ( RuleLink(name == "DRAWING.TRIGGERED", a == pparent) )
>    activeDraw:   RuleLink(name == "LIST.DRAWINGS.ACTIVE", listActive: aasList)
>                  RuleFlag(name == "ACTIVE.DRAWING.LIMIT" ,  eval( doubleValue > listActive.size()) )

>    door:         ManufacturingFeature( name == "general.door"           , value == "NO"       , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "YES"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)
>    isA2LSidePanel:        ManufacturingFeature( name == "general.classification.A2L",  value == "YES",    parent == pparent)
>    isHalfA2lBaffle:        ManufacturingFeature( name == "general.material.a2l.baffle.half.size",  HalfA2lBaffle: value,    parent == pparent)
>    pboundsMf:    ManufacturingFeature( name == "general.bounds",    bounds: value  ,   parent == pparent)
>    dima:         ManufacturingFeature( name == "general.dim.a"         ,               parent == pparent)
>    dimb:         ManufacturingFeature( name == "general.dim.b"         ,               parent == pparent)
>    axisAMf:      ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    axisBMf:      ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)

>    relativeMf:   ManufacturingFeature( name == "general.relative.location",  relativeLocation : value,    parent == pparent)
>    nonAxisMf:    ManufacturingFeature( name == "general.non.axis",           nonAxis : value,    parent == pparent)

>    inBucket:     RuleFlag( name == "IN_BUCKET");
>    outBucket:    RuleFlag( name == "OUT_BUCKET");

>                  RuleFlag( name == "PANELV2.FLANGED.TIP.OFFSET", tipOffset : doubleValue)
then

>    insert(new RuleLink("DRAWING.TRIGGERED", pparent, null));

>    modify (activeDraw) {  getAasList().add(pparent) }

>    BoundingBox panelBounds = BoundingBoxUtil.convertStringToBox(bounds);

>    String why = drools.getRule().getName();
>    String partnumber = pparent.getPartNumber();

>    insert(new QualityEntry(pparent, "NOTE2", "Panel Origin is XA.",5));

>    p.incrementUsage();
>    flanged.incrementUsage();
>    thermalBreak.incrementUsage();
>    door.incrementUsage();
>    relativeMf.incrementUsage();
>    nonAxisMf.incrementUsage();
>    axisAMf.incrementUsage();
>    axisBMf.incrementUsage();
>    pboundsMf.incrementUsage();

>    String outsideFlat = "_std_screwpanel_outside_flat.dxf";
>    String insideFlat  = "_std_screwpanel_inside_flat.dxf";
>    String qc = "_std_screwpanel_qc.dxf";
>    String prefix = RuleHelper.pairMatch(";NO;ntb;YES;tb",thermalBreak.getValue());
>    boolean hasTb = prefix.equals("tb");

>    String weight = getOptionalManufacturingFeature(mi, "general.weight", true); // true = increment usage
>    if (weight.length() > 0) {
>        insert(new QualityEntry(pparent, "WEIGHT.ESTIMATE", weight,200));
>    }

>    // hack for no flange
>    if (getOptionalManufacturingFeature(pparent, "general.flange.gasket", true).equals("NO")) {
>         insert(new QualityEntry(pparent, "FLANGE GASKET", "NO PERIMETER FLANGE GASKET",1000));
>    }

>    String gaugeA = getGauge(pparent, true);
>    String gaugeB = getGauge(pparent, false);
>    boolean needToGrowFlat = needToGrowFlat(gaugeA, gaugeB);
>    boolean hasSpacer   = hasSpacer(pparent);

>    if (hasSpacer) {
>      String aOrB[] = { "a", "b", };
>      for (String letter : aOrB) {
>        // get on rhs...
>        String countS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.count", false); // false = don't increment usage
>        String spaceS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.spacing", false);
>        int count = 0;
>        if (countS.length() > 0) {
>          count = Integer.parseInt(countS);
>        }
>        double space = 0;
>        if (count ==1) {
>          String firstS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.firstHole", false);
>          space = Double.parseDouble(firstS);
>        } else if (spaceS.length() > 0) {
>          space = Double.parseDouble(spaceS);
>        }
>        double dim = dima.getDoubleValue();
>        if (letter.equals("b")) {
>          dim = dimb.getDoubleValue();
>        }
>        Drawing spacer = createSpacerFlat("spacer."+letter,  dim + tipOffset, count, space,  why, outBucket.getValue() + "/" +  partnumber + "_spacer_"+letter+".dxf");
>        insert(spacer);
>        insert(new RuleLink("drawingToParentFlat.spacer." +letter, spacer, pparent));
>        insert(new RuleLink("drawingFlatComplete",  spacer, null));
>      }
>    }
>    if (gaugeB.equals("24/24")) {
>       insert(new RuleLink("TIPA", new Double(dima.getDoubleValue() + tipOffset), pparent));
>       insert(new RuleLink("TIPB", new Double(dimb.getDoubleValue() + tipOffset), pparent));
>    }

>
>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.flat.inside");
>    d.setTemplateFilename(inBucket.getValue() + "/" + prefix + insideFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_inside_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);

>    if (needToGrowFlat) {
>       //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isoutswingdoor)
>       growFlatHelper(d, gaugeA, gaugeB, hasSpacer, hasTb, true, false); // true = inside flat, false means not a door
>    }

>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    // Extract the features - they don't need to be scaled
>    d.extractFeatures("FTR_.*");
>    List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>    d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat " + prefix + insideFlat + " found " + dims.size());
>    }

>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x;
>    double sfmBy = sfmB.getHandle().y;
>
>   // Add A and B Dims to QC
>    final int PLACES = 3;
>    insert(new QualityEntry(pparent, "DIM A", dima.getDoubleValue()+tipOffset, PLACES ,100));
>    insert(new QualityEntry(pparent, "DIM B", dimb.getDoubleValue()+tipOffset, PLACES ,100));
>
>   // now scale the flat
>    d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);
>

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");
>    List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>    if (dflr.size() > 0) {
>      DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    }

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>   // calculate transform from unit coordinates to flat coordinates
>    Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, false, false); // false no flipX , false no flipY
>    insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.inside", d, pparent));
> }

>
>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.flat.outside");
>    d.setTemplateFilename(inBucket.getValue() + "/" + prefix + outsideFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_outside_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);

>    if (needToGrowFlat) {
>       //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor)
>       growFlatHelper(d, gaugeA, gaugeB, hasSpacer, hasTb, false, false); // false = flange flat, false means not a door
>    }

>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    // Extract the features - they don't need to be scaled
>    d.extractFeatures("FTR_.*");
>    List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>    d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat " + prefix + outsideFlat + " found " + dims.size());
>    }
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x;
>    double sfmBy = sfmB.getHandle().y;

>   // now scale the flat
>    d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");
>    List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>    if (dflr.size() > 0) {
>      DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    }

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>   // calculate transform from unit coordinates to flat coordinates
>    Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, false, false); // false no flipX , false no flipY
>    insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.outside", d, pparent));
> }
>  { // control scope of variables
>    String channelFlat =  "a2l_interior_channel.dxf";//"a2l.interior.channel.dxf"; //
>    Drawing d = new Drawing("panel.v2.a2l.flat.channel.internal");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  channelFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_channel_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    System.out.println("the dims are = " + dims);
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    System.out.println("the dimMap are = " + dimMap);
>    double dimB = dimMap.get("LENGTH").doubleValue(); // drawing dimension. make it bigger + this constant
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_LENGTH"); // after which position the length will be added
>    double sfmBx = sfmB.getHandle().x;

>   double channelHeight = 0;
>    if (HalfA2lBaffle.equals("YES")) {
>        channelHeight = dimb.getDoubleValue()/2 + 1.25;
>   } else {
>        channelHeight = dimb.getDoubleValue() - 1.5;
>   }
>   // now scale the flat
>    d.alterDimensionX(channelHeight - dimB,  sfmBx, Double.POSITIVE_INFINITY);

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>    // insert circles
>   final double RADIUS = 0.375/2;
>   double holeTopX = channelHeight - 1;
>   final double holeBottomX = 1;
>   final double holeY = 0.9892;

>   // Now calculate the vertical distance between top and bottom holes
>   double Distance = holeTopX - holeBottomX;

>   // Calculate the number of hole spaces
>   double holeSpaces = Distance / 12;

>  // Round up to the next whole number
>  int numHoles = (int) Math.ceil(holeSpaces) + 1;

>  // Round to the next even number if necessary
>  if (numHoles % 2 != 0) {
>     numHoles++; // Round to the next even number
>  }

>  // Calculate the spacing between the holes
>  double spacing = Distance / (numHoles - 1); // (numHoles - 1) because spaces are between holes, not at the edges

>  // Insert the intermediate holes
>  for (int i = 0; i < numHoles; i++) {
>     double XPosition = holeBottomX + (i * spacing); // Calculate the y-position for each hole
>     d.addCircle(new Point3d(XPosition, holeY, 0), RADIUS, why); // Insert the hole
>  }
>  insert(d);
>  insert(new RuleLink("drawingToParentFlat.a2l.side.channel", d, pparent));
> }
end






// Standard Panel (Tb and NTB)
rule "manufacturing.panel.v2.drawings.20201024.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )
>    mi:           ManufacturedItem( this == pparent, part : partNumber)
>                  not ( RuleLink(name == "DRAWING.TRIGGERED", a == pparent) )
>    activeDraw:   RuleLink(name == "LIST.DRAWINGS.ACTIVE", listActive: aasList)
>                  RuleFlag(name == "ACTIVE.DRAWING.LIMIT" ,  eval( doubleValue > listActive.size()) )

>    door:         ManufacturingFeature( name == "general.door"           , value == "NO"       , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "YES"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)

>    pboundsMf:    ManufacturingFeature( name == "general.bounds",    bounds: value  ,   parent == pparent)
>    dima:         ManufacturingFeature( name == "general.dim.a"         ,               parent == pparent)
>    dimb:         ManufacturingFeature( name == "general.dim.b"         ,               parent == pparent)
>    axisAMf:      ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    axisBMf:      ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)

>    relativeMf:   ManufacturingFeature( name == "general.relative.location",  relativeLocation : value,    parent == pparent)
>    nonAxisMf:    ManufacturingFeature( name == "general.non.axis",           nonAxis : value,    parent == pparent)
>    inBucket:     RuleFlag( name == "IN_BUCKET");
>    outBucket:    RuleFlag( name == "OUT_BUCKET");

>                  RuleFlag( name == "PANELV2.FLANGED.TIP.OFFSET", tipOffset : doubleValue) 
then
>    if (getA2lClassification(mi).equals("NO")) {
>      System.out.println("Starting panel drawing");
>      insert(new RuleLink("DRAWING.TRIGGERED", pparent, null));

>      modify (activeDraw) {  getAasList().add(pparent) }

>      BoundingBox panelBounds = BoundingBoxUtil.convertStringToBox(bounds);

>      String why = drools.getRule().getName();
>      String partnumber = pparent.getPartNumber();

>      insert(new QualityEntry(pparent, "NOTE2", "Panel Origin is XA.",5));

>      p.incrementUsage();
>      flanged.incrementUsage();
>      thermalBreak.incrementUsage();
>      door.incrementUsage();
>      relativeMf.incrementUsage();
>      nonAxisMf.incrementUsage();
>      axisAMf.incrementUsage();
>      axisBMf.incrementUsage();
>      pboundsMf.incrementUsage();

>      String outsideFlat = "_std_screwpanel_outside_flat.dxf";
>      String insideFlat  = "_std_screwpanel_inside_flat.dxf";
>      String qc = "_std_screwpanel_qc.dxf";
>      String prefix = RuleHelper.pairMatch(";NO;ntb;YES;tb",thermalBreak.getValue());
>      boolean hasTb = prefix.equals("tb");

>      String weight = getOptionalManufacturingFeature(mi, "general.weight", true); // true = increment usage
>      if (weight.length() > 0) {
>        insert(new QualityEntry(pparent, "WEIGHT.ESTIMATE", weight,200));
>      }

>      // hack for no flange
>      if (getOptionalManufacturingFeature(pparent, "general.flange.gasket", true).equals("NO")) {
>        insert(new QualityEntry(pparent, "FLANGE GASKET", "NO PERIMETER FLANGE GASKET",1000));
>      }

>      String gaugeA = getGauge(pparent, true);
>      String gaugeB = getGauge(pparent, false);
>      boolean needToGrowFlat = needToGrowFlat(gaugeA, gaugeB);
>      boolean hasSpacer   = hasSpacer(pparent);

>      if (hasSpacer) {
>        String aOrB[] = { "a", "b", };
>        for (String letter : aOrB) {
>          // get on rhs...
>          String countS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.count", false); // false = don't increment usage
>          String spaceS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.spacing", false);
>          int count = 0;
>          if (countS.length() > 0) {
>            count = Integer.parseInt(countS);
>          }
>          double space = 0;
>          if (count ==1) {
>            String firstS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.firstHole", false);
>            space = Double.parseDouble(firstS);
>          } else if (spaceS.length() > 0) {
>            space = Double.parseDouble(spaceS);
>          }
>          double dim = dima.getDoubleValue();
>          if (letter.equals("b")) {
>            dim = dimb.getDoubleValue();
>          }
>          Drawing spacer = createSpacerFlat("spacer."+letter,  dim + tipOffset, count, space,  why, outBucket.getValue() + "/" +  partnumber + "_spacer_"+letter+".dxf");
>          insert(spacer);
>          insert(new RuleLink("drawingToParentFlat.spacer." +letter, spacer, pparent));
>          insert(new RuleLink("drawingFlatComplete",  spacer, null));
>        }
>      }
>      if (gaugeB.equals("24/24")) {
>        insert(new RuleLink("TIPA", new Double(dima.getDoubleValue() + tipOffset), pparent));
>        insert(new RuleLink("TIPB", new Double(dimb.getDoubleValue() + tipOffset), pparent));
>      }
>
>      { // control scope of variables
>      Drawing d = new Drawing("panel.v2.flat.inside");
>      d.setTemplateFilename(inBucket.getValue() + "/" + prefix + insideFlat, why);
>      d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_inside_flat.dxf" , why);
>      d.readTemplateFromFile(why);
>      d.zeroDrawingLowerLeft(why);

>      if (needToGrowFlat) {
>        //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isoutswingdoor)
>        growFlatHelper(d, gaugeA, gaugeB, hasSpacer, hasTb, true, false); // true = inside flat, false means not a door
>      }

>      d.extractFeatures("DIM_.*");
>      d.extractFeatures("ORG_SFM.*");

>      // Extract the features - they don't need to be scaled
>      d.extractFeatures("FTR_.*");
>      List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>      DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>      d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>      List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>      if (dims.size() != 2) {
>        throw new Exception("Failed to find two DIM_ entries in flat " + prefix + insideFlat + " found " + dims.size());
>      }

>      Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>      double dimA = dimMap.get("A").doubleValue();
>      double dimB = dimMap.get("B").doubleValue();
>
>      // now get the spindle fold mutilate points
>      DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>      DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>      double sfmAx = sfmA.getHandle().x;
>      double sfmBy = sfmB.getHandle().y;
>
>      // Add A and B Dims to QC
>      final int PLACES = 3;
>      insert(new QualityEntry(pparent, "DIM A", dima.getDoubleValue()+tipOffset, PLACES ,100));
>      insert(new QualityEntry(pparent, "DIM B", dimb.getDoubleValue()+tipOffset, PLACES ,100));
>
>      // now scale the flat
>      d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>      d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);
>

>      // extract the repeating patterns ONLY after the scale
>      d.extractFeatures("RPT_.*");
>      List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>      if (dflr.size() > 0) {
>        DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>      }

>      // extract the bounds and anchor points  ONLY after the scale
>      d.extractFeatures("BOUND_.*");
>      d.extractFeatures("ORG_.*");
>      // calculate transform from unit coordinates to flat coordinates
>      Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, false, false); // false no flipX , false no flipY
>      insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>      insert(d);
>      insert(new RuleLink("drawingToParentFlat.inside", d, pparent));
>    }

>
>      { // control scope of variables
>        Drawing d = new Drawing("panel.v2.flat.outside");
>        d.setTemplateFilename(inBucket.getValue() + "/" + prefix + outsideFlat, why);
>        d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_outside_flat.dxf" , why);
>        d.readTemplateFromFile(why);
>        d.zeroDrawingLowerLeft(why);

>        if (needToGrowFlat) {
>           //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor)
>           growFlatHelper(d, gaugeA, gaugeB, hasSpacer, hasTb, false, false); // false = flange flat, false means not a door
>        }

>        d.extractFeatures("DIM_.*");
>        d.extractFeatures("ORG_SFM.*");

>        // Extract the features - they don't need to be scaled
>        d.extractFeatures("FTR_.*");
>        List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>        DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>        d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>        List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>        if (dims.size() != 2) {
>          throw new Exception("Failed to find two DIM_ entries in flat " + prefix + outsideFlat + " found " + dims.size());
>        }
>        Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>        double dimA = dimMap.get("A").doubleValue();
>        double dimB = dimMap.get("B").doubleValue();
>
>        // now get the spindle fold mutilate points
>        DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>        DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>        double sfmAx = sfmA.getHandle().x;
>        double sfmBy = sfmB.getHandle().y;

>         // now scale the flat
>        d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>        d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>        // extract the repeating patterns ONLY after the scale
>        d.extractFeatures("RPT_.*");
>        List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>        if (dflr.size() > 0) {
>          DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>        }

>        // extract the bounds and anchor points  ONLY after the scale
>        d.extractFeatures("BOUND_.*");
>        d.extractFeatures("ORG_.*");

>        // calculate transform from unit coordinates to flat coordinates
>        Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, false, false); // false no flipX , false no flipY
>        insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>        insert(d);
>        insert(new RuleLink("drawingToParentFlat.outside", d, pparent));
>     }
> }
end


// outswing door - doesn't check for TB or NTB - always build as TB
// June 5 2012 altered outswing full flange for different stiffener, viewport size change
rule "manufacturing.panel.v2.outswing.drawings.20201025.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )

>                  not ( RuleLink(name == "DRAWING.TRIGGERED", a == pparent) )
>    activeDraw:   RuleLink(name == "LIST.DRAWINGS.ACTIVE", listActive: aasList)
>                  RuleFlag(name == "ACTIVE.DRAWING.LIMIT" ,  eval( doubleValue > listActive.size()) )

>    door:         ManufacturingFeature( name == "general.door"           , value == "OUTSWING" , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "NO"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)
>    dima:         ManufacturingFeature( name == "general.dim.a"         ,                        parent == pparent)
>    dimb:         ManufacturingFeature( name == "general.dim.b"         ,                        parent == pparent)
>    orient:       ManufacturingFeature( name == "general.orientation"   , orientation: value,    parent == pparent)

>    pboundsMf:    ManufacturingFeature( name == "general.bounds",    bounds: value  ,   parent == pparent)
>    axisAMf:      ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    axisBMf:      ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>    relativeMf:   ManufacturingFeature( name == "general.relative.location",  relativeLocation : value,    parent == pparent)
>    nonAxisMf:    ManufacturingFeature( name == "general.non.axis",           nonAxis : value,    parent == pparent)
>    hingeMf:      ManufacturingFeature( name == "general.hinge.location",           hingeLocation : value,    parent == pparent)


>                  RuleFlag( name == "PANELV2.FLANGED.TIP.DOOR.X.OFFSET", tipOffsetX : doubleValue) 
>                  RuleFlag( name == "PANELV2.FLANGED.TIP.DOOR.Y.OFFSET", tipOffsetY : doubleValue) 

>    inBucket:     RuleFlag( name == "IN_BUCKET");
>    outBucket:    RuleFlag( name == "OUT_BUCKET");
then
>    System.out.println("Starting panel outswing door drawing");

>    insert(new RuleLink("DRAWING.TRIGGERED", pparent, null));
>    modify (activeDraw) {  getAasList().add(pparent) }

>    BoundingBox panelBounds = BoundingBoxUtil.convertStringToBox(bounds);
>    String why = drools.getRule().getName();
>    String partnumber = pparent.getPartNumber();
>    p.incrementUsage();
>    flanged.incrementUsage(); 
>    thermalBreak.incrementUsage(); 
>    door.incrementUsage();
>    relativeMf.incrementUsage();
>    nonAxisMf.incrementUsage();
>    axisAMf.incrementUsage();
>    axisBMf.incrementUsage();
>    pboundsMf.incrementUsage();
>    hingeMf.incrementUsage();

>    // hack for optional wide door flange
>    String doorFlange = getOptionalManufacturingFeature(pparent, "general.door.flange", true);  // true = increment usage
>    boolean wideFlangeDoor = doorFlange.equals("STANDARD");

>    String weight = getOptionalManufacturingFeature(pparent, "general.weight", true);  // true = increment usage
>    if (weight.length() > 0) {
>        insert(new QualityEntry(pparent, "WEIGHT.ESTIMATE", weight,200));
>    }

>    String gaugeA = getGauge(pparent, true);
>    String gaugeB = getGauge(pparent, false);
>    boolean needToGrowFlat = needToGrowFlat(gaugeA, gaugeB);
>    boolean hasSpacer   = hasSpacer(pparent);

>    String outsideFlat = (wideFlangeDoor) ? "outswing.fullflange.flange.dxf" : "outswing_door_flange_flat.dxf";
>    String insideFlat  = (wideFlangeDoor) ? "outswing.fullflange.non.flange.dxf" : "outswing_door_noflange_flat.dxf";
>    String backFlat    = (wideFlangeDoor) ? "" : "outswing_door_backplate_flat.dxf";
>    String channelFlat = (wideFlangeDoor) ? "outswing.fullflange.channel.dxf" : "outswing_door_channel_flat.dxf";
>    String flangeLarge = (wideFlangeDoor) ? "YES" : "NO";

>    if (wideFlangeDoor) {
>       tipOffsetX = tipOffsetY; // same flange all around
>    }

>    if (hasSpacer) { 
>      String aOrB[] = { "a", "b", };
>      for (String letter : aOrB) {
>        double dim = (letter.equals("b")) ? dimb.getDoubleValue() : dima.getDoubleValue();
>        Drawing spacer = createSpacerFlat("spacer."+letter,  dim + tipOffsetX, 0, 0,  why, outBucket.getValue() + "/" +  partnumber + "_spacer_"+letter+".dxf"); // tipOffsetX is the same as tipOffsetY at this time (spacer requires wide flange)
>        insert(spacer);
>        insert(new RuleLink("drawingToParentFlat.spacer." +letter, spacer, pparent));
>        insert(new RuleLink("drawingFlatComplete", spacer, null));
>      }
>    }

>    insert(new RuleLink("FULLFLANGE",flangeLarge,pparent));
>
>
>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.outswing.door.flat.inside");
>    d.setTemplateFilename(inBucket.getValue() + "/" + insideFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_inside_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);

>    if (needToGrowFlat) {
>       //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor)
>       growFlatHelper(d, gaugeA, gaugeB, hasSpacer, true, true, true); // true =isTb, true = inside flat, true = outswing door
>    }


>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    // Extract the features - they don't need to be scaled
>    d.extractFeatures("FTR_.*");
>    List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>    d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat " + insideFlat + " found " + dims.size());
>    }
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x; 
>    double sfmBy = sfmB.getHandle().y; 
>
>   // Add A and B Dims to QC
>    final int PLACES = 3;
>    insert(new QualityEntry(pparent, "DIM A", dima.getDoubleValue() + tipOffsetX, PLACES ,100));
>    insert(new QualityEntry(pparent, "DIM B", dimb.getDoubleValue()+ tipOffsetY, PLACES ,100));

>    insert(new QualityEntry(pparent, "NOTE2", "Panel Origin is XA.",5));

>
>   // now scale the flat
>    d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);
>

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");
>    List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>    if (dflr.size() > 0) {
>      DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    }

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>   // calculate transform from unit coordinates to flat coordinates
>    Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, hingeLocation.equals("INVERT"), hingeLocation.equals("INVERT")); // flipX onto flat, flipY onto flat
>    insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.outswing.door.inside", d, pparent));
> }

>
>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.outswing.door.flat.outside");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  outsideFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_outside_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);

>    if (needToGrowFlat) {
>       //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor)
>       growFlatHelper(d, gaugeA, gaugeB, hasSpacer, true, false,true); // true =isTb, false = outside flat, true = outswingdoor
>    }

>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");


>    // Extract the features - they don't need to be scaled
>    d.extractFeatures("FTR_.*");
>    List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>    d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat " + outsideFlat + " found " + dims.size());
>    }
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x; 
>    double sfmBy = sfmB.getHandle().y; 

>   // now scale the flat
>    d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");
>    List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>    if (dflr.size() > 0) {
>      DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    }

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");


>   // calculate transform from unit coordinates to flat coordinates
>    Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, hingeLocation.equals("INVERT"), hingeLocation.equals("INVERT")); // flipX onto flat, flipY onto flat
>    insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.outswing.door.outside", d, pparent));
                          
> }


>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.outswing.door.flat.channel.internal.hingecount");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  channelFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_channel_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    double sfmAx = sfmA.getHandle().x; 

>   // now scale the flat
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.outswing.door.channel", d, pparent));
> }

>  { // control scope of variables
>   if (backFlat.length() > 1) {
>    Drawing d = new Drawing("panel.v2.outswing.door.flat.backplate.internal.hingecount");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  backFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_backplate_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    double sfmAx = sfmA.getHandle().x; 

>   // now scale the flat
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.outswing.door.backplate", d, pparent));
>   } // backflat length test
> }
end


// CAUTION: Inswing doors have different tip to tip adders
rule "manufacturing.panel.v2.inswing.thru.drawings.20201025.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )

>                  not ( RuleLink(name == "DRAWING.TRIGGERED", a == pparent) )
>    activeDraw:   RuleLink(name == "LIST.DRAWINGS.ACTIVE", listActive: aasList)
>                  RuleFlag(name == "ACTIVE.DRAWING.LIMIT" ,  eval( doubleValue > listActive.size()) )

>    door:         ManufacturingFeature( name == "general.door"           , value == "INSWING" , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "NO"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)
>    dima:         ManufacturingFeature( name == "general.dim.a"         ,                        parent == pparent)
>    dimb:         ManufacturingFeature( name == "general.dim.b"         ,                        parent == pparent)
>    orient:       ManufacturingFeature( name == "general.orientation"   , orientation: value,    parent == pparent)
>                  ManufacturingFeature( name == "general.internal.handle"   , value == "YES",    parent == pparent) 

>    pboundsMf:    ManufacturingFeature( name == "general.bounds",    bounds: value  ,   parent == pparent)
>    axisAMf:      ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    axisBMf:      ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>    relativeMf:   ManufacturingFeature( name == "general.relative.location",  relativeLocation : value,    parent == pparent)
>    nonAxisMf:    ManufacturingFeature( name == "general.non.axis",           nonAxis : value,    parent == pparent)
>    hingeMf:      ManufacturingFeature( name == "general.hinge.location",           hingeLocation : value,    parent == pparent)

>    inBucket:     RuleFlag( name == "IN_BUCKET");
>    outBucket:    RuleFlag( name == "OUT_BUCKET");
>                  RuleFlag( name == "PANELV2.FLANGED.TIP.DOOR.X.OFFSET", tipOffsetX : doubleValue) 
>                  RuleFlag( name == "PANELV2.FLANGED.TIP.DOOR.Y.OFFSET", tipOffsetY : doubleValue) 

then
>    System.out.println("Starting panel inswing door thru handle drawing");

>    insert(new RuleLink("DRAWING.TRIGGERED", pparent, null));
>    modify (activeDraw) {  getAasList().add(pparent) }

>    BoundingBox panelBounds = BoundingBoxUtil.convertStringToBox(bounds);
>    String why = drools.getRule().getName();
>    String partnumber = pparent.getPartNumber();
>    p.incrementUsage();
>    flanged.incrementUsage(); 
>    thermalBreak.incrementUsage(); 
>    door.incrementUsage();
>    relativeMf.incrementUsage();
>    nonAxisMf.incrementUsage();
>    axisAMf.incrementUsage();
>    axisBMf.incrementUsage();
>    pboundsMf.incrementUsage();
>    hingeMf.incrementUsage();


>    String lockinghandle = getOptionalManufacturingFeature(pparent, "general.lockinghandle", true);  // true = increment usage
>    boolean hasLockingHandle  = lockinghandle.equals("YES");

>    String weight = getOptionalManufacturingFeature(pparent, "general.weight", true); // get gauge, if we have them
>    if (weight.length() > 0) {
>        insert(new QualityEntry(pparent, "WEIGHT.ESTIMATE", weight,200));
>    }

>    String gaugeA = getGauge(pparent, true);
>    String gaugeB = getGauge(pparent, false);
>    boolean needToGrowFlat = needToGrowFlat(gaugeA, gaugeB);
>    boolean hasSpacer   = hasSpacer(pparent); // always false for inswing doors

>    if (gaugeB.equals("24/24")) {
>       insert(new RuleLink("TIPA", new Double(dima.getDoubleValue() + tipOffsetX), pparent)); 
>       insert(new RuleLink("TIPB", new Double(dimb.getDoubleValue() + tipOffsetY), pparent));
>    }

>    String flangeFlat = "inswing_thru_flange_flat.dxf";
>    String noFlangeFlat = "inswing_thru_noflange_flat.dxf";
>    String qc = "inswing_thru_qc.dxf";
>    if (hasLockingHandle) {
>      noFlangeFlat = "inswing_thru_noflange_flat.nohex.dxf";
>      qc = "inswing_thru_qc.nohex.dxf";
>    }
>    insert(new RuleLink("QCFLAT", pparent, qc));

>    String backFlat = "inswing_thru_backplate_flat.dxf";
>    String channelFlat = "inswing_thru_channel_flat.dxf";

>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.inswing.door.flat.flange");
>    d.setTemplateFilename(inBucket.getValue() + "/" + flangeFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_flange_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);

>    if (needToGrowFlat) {
>       //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor)
>       growFlatHelper(d, gaugeA, gaugeB, hasSpacer, true, false, false); // false = flange flat, false menas not outswingdoor
>    }


>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    // Extract the features - they don't need to be scaled
>    d.extractFeatures("FTR_.*");
>    List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>    d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat " + flangeFlat + " found " + dims.size());
>    }
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x; 
>    double sfmBy = sfmB.getHandle().y; 
>
>   // Add A and B Dims to QC
>    final int PLACES = 3;
>    insert(new QualityEntry(pparent, "DIM A", dima.getDoubleValue() + tipOffsetX, PLACES ,100));
>    insert(new QualityEntry(pparent, "DIM B", dimb.getDoubleValue() + tipOffsetY, PLACES ,100));

>    insert(new QualityEntry(pparent, "NOTE2", "Panel Origin is XA.",5));
>
>   // now scale the flat
>    d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);
>

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");


>   // calculate transform from unit coordinates to flat coordinates
>    Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, hingeLocation.equals("INVERT"), hingeLocation.equals("STANDARD")); // flipX onto flat, flipY onto flat
>    insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.inswing.door.flange", d, pparent));
> }

>
>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.inswing.door.flat.noflange");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  noFlangeFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_noflange_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);

>    if (needToGrowFlat) {
>       //growFlatHelper(Drawing d, String gaugeA, String gaugeB, boolean hasSpacer, boolean isTb, boolean isNonFlange, boolean isOutswingDoor)
>       growFlatHelper(d, gaugeA, gaugeB, hasSpacer, true, true, false); // true = non flange flat, false means not outswing door
>    }


>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    // Extract the features - they don't need to be scaled
>    d.extractFeatures("FTR_.*");
>    List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>    d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, true); // zero x and y

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat " + noFlangeFlat + " found " + dims.size());
>    }
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x; 
>    double sfmBy = sfmB.getHandle().y; 

>   // now scale the flat
>    d.alterDimensionY(dimb.getDoubleValue() - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>   // calculate transform from unit coordinates to flat coordinates
>    Transform3D unitToFlatTransform[] = calculateTransformAlt(aAxis, bAxis, nonAxis, relativeLocation, d, panelBounds, hingeLocation.equals("INVERT"), hingeLocation.equals("STANDARD")); // flipX onto flat, flipY onto flat
>    insert(new RuleLink("drawingToTransformLink", d, unitToFlatTransform));

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.inswing.door.noflange", d, pparent));
                          
> }


>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.inswing.door.flat.channel.internal.hingecount");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  channelFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_channel_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");


>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    double sfmAx = sfmA.getHandle().x; 

>   // now scale the flat
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.inswing.door.channel", d, pparent));
> }

>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.inswing.door.flat.backplate.internal.hingecount");
>    d.setTemplateFilename(inBucket.getValue() + "/" +  backFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_backplate_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");


>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    double sfmAx = sfmA.getHandle().x; 

>   // now scale the flat
>    d.alterDimensionX(dima.getDoubleValue() - dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.inswing.door.backplate", d, pparent));
> }


end




