rule "manufacturing.panel.v2.drawings.perforated.style.v2.flag.20171207.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )
>                  ManufacturingFeature( name == "general.material.a.perforated"  , value == "YES"       , parent == pparent)
>                  ( exists (ManufacturingFeature( name == "feature.noperf"        ,  parent == pparent) ) )
>                  or 
>                  ( exists (ManufacturingFeature( name == "feature.perfrectangle"  ,  parent == pparent) ) )
>                  not (RuleLink( name == "PERFVERSION"  ,  b == pparent) )
then
>   insert(new RuleLink("PERFVERSION", "V2", pparent));
end









// Add Door Frame Parts using AddDoorFrameFlatsV2 as a trigger
rule "manufacturing.panel.v2.drawings.doorframe.v2.20170907.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )
>    door:         ManufacturingFeature( name == "general.door"           , value == "NO"       , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "YES"      , parent == pparent)


>                  RuleLink(name == "DRAWING.TRIGGERED", a == pparent)  // only generate for triggered drawings


>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)

>                  RuleLink(  name == "AddDoorFrameFlatsV2",  a == pparent, frameBoundsO: b)

>    inBucket:     RuleFlag( name == "IN_BUCKET");
>    outBucket:    RuleFlag( name == "OUT_BUCKET");
then
>    System.out.println("Starting panel drawing add door frame flats");
>    String why = drools.getRule().getName();
>    String partnumber = pparent.getPartNumber();

>        // c channel vertical (qty 2), c channel h (qty 2)
>    BoundingBox bounds = (BoundingBox) frameBoundsO;
>    Point3d l = new Point3d(0,0,0);
>    Point3d u = new Point3d(0,0,0);
>    bounds.getLower(l);
>    bounds.getUpper(u);

>    String cHFlat = "door_frame_channel_h_flat_v2.dxf";
>    String cVFlat = "door_frame_channel_v_flat_v2.dxf";
> ///////////////////////////////////////////////////////////////////////////
> ///////////////////////////////////////////////////////////////////////////
> //                   CHANNEL HORIZONTAL
> ///////////////////////////////////////////////////////////////////////////
> ///////////////////////////////////////////////////////////////////////////

>   System.out.println("Starting " + "panel.v2.flat.c.h");

>   double w = 0;
>   String wS = getOptionalManufacturingFeature(pparent, "general.doorframe.w", false);
>    
>   if (wS.length() > 0) {
>      w = Double.parseDouble(wS);
>   }

>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.flat.c.h");
>    d.setTemplateFilename(inBucket.getValue() + "/" + cHFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_channel_h_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    double sfmAx = sfmA.getHandle().x; 

>    if (w > 0.01) {
>        DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>        double sfmBy = sfmB.getHandle().y; 
>        double dimB = dimMap.get("B").doubleValue();
>        d.alterDimensionY(w - dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    }
>
>   // now scale the flat
>    d.alterDimensionX((u.x-l.x)- dimA,  sfmAx, Double.POSITIVE_INFINITY);

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    d.zeroFeatures("RPT_.*", new Point3d(0,0,0), true, false); // zero x, not y

>
>
>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("ORG_.*");

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.doorframe.c.h", d, pparent));
> }

> ///////////////////////////////////////////////////////////////////////////
> ///////////////////////////////////////////////////////////////////////////
> //                   CHANNEL VERTICAL
> ///////////////////////////////////////////////////////////////////////////
> ///////////////////////////////////////////////////////////////////////////

>   System.out.println("Starting " + "panel.v2.flat.c.v");
>   //try {
>  { // control scope of variables
>    Drawing d = new Drawing("panel.v2.flat.c.v");
>    d.setTemplateFilename(inBucket.getValue() + "/" + cVFlat, why);
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + "_channel_v_flat.dxf" , why);
>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmBy = sfmB.getHandle().y; 
>
>    if (w > 0.01) {
>        DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>        double sfmAx = sfmA.getHandle().x; 
>        double dimA = dimMap.get("A").doubleValue();
>        d.alterDimensionX(w - dimA,  sfmAx, Double.POSITIVE_INFINITY);
>    }
>
>   // now scale the flat
>    d.alterDimensionY((u.y-l.y)- dimB,  sfmBy, Double.POSITIVE_INFINITY);

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    d.zeroFeatures("RPT_.*", new Point3d(0,0,0), false, true); // not x, zero y


>    d.extractFeatures("FTR_.*");
>    DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>
>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("ORG_.*");

>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.doorframe.c.v", d, pparent));
> }
>  //} catch (Exception e) {
>  //  e.printStackTrace();
>  //  throw e;
> // }
>   System.out.println("done with door frame");

end





rule "manufacturing.panel.v2.drawings.outswing.qc.20110711.01"
//
//  This rule starts with a Manufactured item and defines the qc drawing
//
when
>    p:          ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>                RuleLink(name == "DRAWING.TRIGGERED", a == pparent)  // only generate qc for triggered drawings

>    door:         ManufacturingFeature( name == "general.door"           , value == "OUTSWING"       , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "NO"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)

>    fullflange:   RuleLink(name == "FULLFLANGE", fullf: aasString, b== pparent)


>    inBucket:   RuleFlag( name == "IN_BUCKET")
>    outBucket:  RuleFlag( name == "OUT_BUCKET")
then
>    String why = drools.getRule().getName();
>    insert(new QualityEntry(pparent, "Panel Quality Control Drawing Rev 0.0 20110615.01",2));
>    String qcName = "outswing_door_qc.dxf";
>    if (fullf.equals("YES")) {
>       qcName = "outswing.fullflange.qc.dxf";
>    }
>    Drawing d = new Drawing("panel.v2.outswing.qc");
>    d.setTemplateFilename(inBucket.getValue() + "/" + qcName, why);
>    String partnumber = pparent.getPartNumber();
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + ".dxf" , why);
>    // do not read template from file yet - no reason to load it into memory
>    insert(d);
>    insert(new RuleLink("drawingToParentQC", d, pparent));
end


// thru the handle design
rule "manufacturing.panel.v2.drawings.inswing.thru.qc.20170821.01"
//
//  This rule starts with a Manufactured item and defines the qc drawing
//
when
>    p:          ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>                RuleLink(name == "DRAWING.TRIGGERED", a == pparent)  // only generate qc for triggered drawings

>                RuleLink(name == "QCFLAT", a == pparent, qcName: basString)

>    door:         ManufacturingFeature( name == "general.door"           , value == "INSWING"       , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "NO"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)

>                  ManufacturingFeature( name == "general.internal.handle"   , value == "YES",    parent == pparent) 

>    inBucket:   RuleFlag( name == "IN_BUCKET")
>    outBucket:  RuleFlag( name == "OUT_BUCKET")
then
>    String why = drools.getRule().getName();
>    insert(new QualityEntry(pparent, "Panel Quality Control Drawing Rev 0.0 20110615.01",2));
>    //String qcName = "inswing_thru_qc.dxf";

>    Drawing d = new Drawing("panel.v2.inswing.qc");
>    d.setTemplateFilename(inBucket.getValue() + "/" + qcName, why);
>    String partnumber = pparent.getPartNumber();
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + ".dxf" , why);
>    // do not read template from file yet - no reason to load it into memory
>    insert(d);
>    insert(new RuleLink("drawingToParentQC", d, pparent));
end




rule "manufacturing.panel.v2.drawings.qc.20110615.01"
//
//  This rule starts with a Manufactured item and defines the qc drawing
//
when
>    p:          ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>                RuleLink(name == "DRAWING.TRIGGERED", a == pparent)  // only generate qc for triggered drawings

>    door:         ManufacturingFeature( name == "general.door"           , value == "NO"       , parent == pparent)
>    flanged:      ManufacturingFeature( name == "general.flanged"        , value == "YES"      , parent == pparent)
>    thermalBreak: ManufacturingFeature( name == "general.thermalbreak"  ,                        parent == pparent)


>    inBucket:   RuleFlag( name == "IN_BUCKET")
>    outBucket:  RuleFlag( name == "OUT_BUCKET")
then
>    String why = drools.getRule().getName();
>    insert(new QualityEntry(pparent, "Panel Quality Control Drawing Rev 0.0 20110615.01",2));
>    String qcName = RuleHelper.pairMatch(";NO;ntb_std_screwpanel_qc.dxf;YES;tb_std_screwpanel_qc.dxf",thermalBreak.getValue());

>    Drawing d = new Drawing("panel.v2.qc");
>    d.setTemplateFilename(inBucket.getValue() + "/" + qcName, why);
>    String partnumber = pparent.getPartNumber();
>    d.setOutputFilename(outBucket.getValue() + "/" +  partnumber + ".dxf" , why);
>    // do not read template from file yet - no reason to load it into memory
>    insert(d);
>    insert(new RuleLink("drawingToParentQC", d, pparent));
end


rule "manufacturing.panel.v2.drawings.bom.20180417.01"
//
//  Define bill of material master 
//
when
>    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>    RuleLink(name == "DRAWING.TRIGGERED", a == pparent)  // only generate bom for triggered drawings

then
>    String weight = getOptionalManufacturingFeature(pparent, "general.weight", true); // get gauge, if we have them
>   // Start Bill of Material
>    BillOfMaterial bom = new BillOfMaterial(BillOfMaterial.PURPOSE_MAIN, pparent.getPartNumber(), pparent.getDescription());
>    if (weight.length() > 0) {
>       bom.setWeight(weight);
>    }
>    insert(bom);
>    insert(new RuleLink("bomToParent", bom, pparent));
end



rule "manufacturing.panel.v2.drawings.bom.flat.20171222.01"
//
//  This rule creates the bom entry for both panel flats
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>   ManufacturingFeature( name == "general.hinge.count",  hcount: value , parent == pparent  )

>   RuleLink( name matches "drawingToParentFlat.*",  b == pparent , flatO: a )
>   RuleLink( name == "drawingFlatComplete",  a == flatO)

>   RuleLink( name == "bomToParent", b == pparent, bom: a )

then
>   Drawing drawing = (Drawing) flatO;
>   String dName = drawing.getDrawingName();
>   String materialName = RuleHelper.pairMatch(";.*perf.*;general.material.a;.*inswing.door.flat.noflange;general.material.a;.*inswing.door.flat.flange;general.material.b;.*internal.*;SKIP;.*rain.*;general.material.b;.*c.[hv];general.material.b;.*inside.*;general.material.a;.*outside.*;general.material.b;.*spacer..;SPACER",dName);
>   String material = null;
>   double qty = 1;
>   String gauge = null;  
>   if (!materialName.equalsIgnoreCase("SKIP") && !materialName.equalsIgnoreCase("SPACER")) {
>       ManufacturingFeature  materialF = pparent.getFeature(materialName);
>       material = materialF.getValue();
>   } else if (drawing.getDrawingName().matches(".*hingecount.*")) {    // for internal components check for hingecount, if found use count as quantity 
>      int hingeCount = Integer.parseInt(hcount);
>      qty = hingeCount;
>   } else if (materialName.equalsIgnoreCase("SPACER")) {
>     qty = 2;
>     material = "(VA03-56)";
>     gauge = "16";
>   }

>   if (gauge == null) {
>      String gaugeName = RuleHelper.pairMatch(";.*inswing.door.flat.noflange;general.gauge.a;.*inswing.door.flat.flange;general.gauge.b;.*inside.*;general.gauge.a;.*outside.*;general.gauge.b;.*;SKIP",dName);
>      if (!gaugeName.equalsIgnoreCase("SKIP")) {
>        String g = getOptionalManufacturingFeature(pparent, gaugeName, false);
>        if (g.length() > 0) {
>          gauge = g;
>        }
>      }
>   }


>   // hack for door frame qty = 2 items
>   if (dName.matches(".*rain.h.*")) {
>     qty = 2;
>   }
>   if (dName.matches(".*c.[hv]")) {
>     qty = 2;
>     gauge = "16";
>   }
>   // hack for perf brackets qty = 2 items
>   if (dName.matches(".*perf.[hv]")) {
>     qty = 2;
>   }
>
>    // assumes drawing starts at 0,0
>   Point3d extent = drawing.getMaximumExtent();
>   final int PLACES =4;
>   extent.x = Rounding.round(extent.x, PLACES);
>   extent.y = Rounding.round(extent.y, PLACES);
>   extent.z = 0;
>   BillOfMaterial bomChild = new BillOfMaterial(BillOfMaterial.PURPOSE_DYNAMIC, null, "Flat " + extent.x  + " x " + extent.y ,
>           material, gauge, new File(drawing.getOutputFilename()).getName() , qty, 
>           new BoundingBox( new Point3d(), extent));
>//   drawing.clearData();
>   ((BillOfMaterial) bom).addChild(bomChild);
end


rule "manufacturing.panel.v2.drawings.bom.raw.20090714.01"
//
//  This rule creates the bom entry for static stuff added by intersector rules
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "billofmaterial.raw",  bomraw : value , parent == pparent  )
>         RuleLink( name == "bomToParent", bom: a , b == pparent)

then
>   String[] parts = bomraw.split("\\t");
>   if (parts.length < 3) {
>      throw new Exception("Failed to split bomraw into 3 parts " + bomraw + " " + parts.length);
>   }
>   final int PART = 1;
>   final int QTY = 2;
>   BillOfMaterial bomChild = new BillOfMaterial(BillOfMaterial.PURPOSE_STATIC, parts[PART], "Static Part" ,
>           null, null, null , Double.parseDouble(parts[QTY]), null);
>   ((BillOfMaterial) bom).addChild(bomChild);

>  // also add to QC
>    insert(new QualityEntry(pparent, "STATIC", "["+ parts[PART] + "  QTY" + parts[QTY]+"]" ,1000));
end







rule "manufacturing.panel.v2.drawings.bom.qc.20101004.01"
//
//  This rule creates the bom entry
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )

>   RuleLink( name == "drawingToParentQC", b == pparent ,  dO : a )
>   RuleLink( name == "drawingQCComplete",  a == dO)

>   RuleLink( name == "bomToParent" , b == pparent, bom: a)
then
>   Drawing drawing = (Drawing) dO;
>   BillOfMaterial bomChild = new BillOfMaterial(BillOfMaterial.PURPOSE_QC, null, "QUALITY CONTROL",
>           null, null, new File(drawing.getOutputFilename()).getName() , 1.0, null);
>   drawing.clearData();
>   retract(drawing);
>   ((BillOfMaterial) bom).addChild(bomChild);
>   insert(new RuleLink("GENERATE.PANEL.BOM", pparent, null));
end


rule "manufacturing.panel.v2.drawings.bom.generate.20090410.01"
//
//  This rule creates the bom file
//
//
//salience -4000  
//no-loop true
when
>  bomFlag: RuleLink( name == "GENERATE.PANEL.BOM", pparent: a)
>   activeDraw:   RuleLink(name == "LIST.DRAWINGS.ACTIVE", listActive: aasList)
>   RuleLink( name == "bomToParent", bomO: a , b == pparent)
>   outBucket:  RuleFlag( name == "OUT_BUCKET");
>   RuleLink( name == "LIST.DRAWINGS.COMPLETED", completed: aasList);
then
>      ManufacturedItem mi = (ManufacturedItem) pparent;
>      String filename = outBucket.getValue() + "/" +  mi.getPartNumber() + ".bom.xml" ;
>      BillOfMaterial bom = (BillOfMaterial) bomO;
>      bom.createXml(filename);
>      bom.clearBom(bom);
>      // add to completed drawing list
>      completed.add(pparent);
>      System.out.println("Removing " + mi.getPartNumber() + " from active drawing list " + listActive.size());
>      modify (activeDraw) {  getAasList().remove(pparent) }
>      retract(bomFlag);
end

// look for general.gauge.a and general.gauge.b on the RHS
rule "manufacturing.panel.v2.drawings.qc.generate.20171221.01"
salience -3000
//
//  This rule creates the qc drawing, after the flat has completed
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>   materialA: ManufacturingFeature( name == "general.material.a"  ,                        parent == pparent)
>   materialB: ManufacturingFeature( name == "general.material.b"  ,                        parent == pparent)

>   RuleLink( name == "drawingToParentFlat.inside", b == pparent, flatInsideO : a   )
>   RuleLink( name == "drawingFlatComplete",  a == flatInsideO)

>   RuleLink( name == "drawingToParentFlat.outside",  b == pparent,   flatOutsideO: a )
>   RuleLink( name == "drawingFlatComplete",  a == flatOutsideO)

>   RuleLink( name == "drawingToParentQC"  ,  qcO : a , b == pparent)

then
>    String why = drools.getRule().getName();
>
>    ManufacturedItem mi =  pparent;
>    WorkingMemory wm = drools.getWorkingMemory();
>    List<QualityEntry>  qel  = WorkspaceQuery.queryByParent( wm, "QualityEntryByParent", mi);
>    Drawing d = (Drawing) qcO;

>    System.out.println("Generating drawing qc " + d.getDrawingName() + " " + d.getOutputFilename());

>    d.readTemplateFromFile(why);
>    d.extractFeatures("PT_.*");
>    d.extractFeatures("ORG_.*");
>
>    Point3d handle =  d.getFeature("PT_TBL").getHandle();
>    SimpleDxfTable sdt = new SimpleDxfTable(d);
>    sdt.setColAWidth(4.0); // inches for name
>    sdt.setColBWidth(6.0); // inches for values
>   
>    sdt.generate(QualityEntry.condense(qel), handle);
>    
>    Point4d textOrigin = new Point4d(0,0,0,-.33);
>    handle =  d.getFeature("PT_PARTNUMBER").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.20;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( mi.getPartNumber(),  why);


>    String desc = materialA.getValue();
>    ManufacturingFeature gaugea = pparent.getOptionalFeature("general.gauge.a");
>    if (gaugea != null) {
>      desc = desc + " " + gaugea.getValue(); 
>    }
>
>    handle =  d.getFeature("PT_MTL_INSIDE").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.20;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( desc,  why);
>


>    desc = materialB.getValue();
>    gaugea = pparent.getOptionalFeature("general.gauge.b");
>    if (gaugea != null) {
>      desc = desc + " " + gaugea.getValue(); 
>    }
>
>    handle =  d.getFeature("PT_MTL_OUTSIDE").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.20;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( desc,  why);
>
>

>    handle =  d.getFeature("PT_REF").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.40;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( mi.getPartNumber(),  why);
>

>    handle =  d.getFeature("ORG_ANC_LL").getHandle();
>    double handleX = handle.x;
>    Point3d qcExtent = d.getFeature("ORG_ANC_UR").getHandle();
>    System.out.println("QC Area  lower=" + handle + " upper=" + qcExtent +"for "+  mi.getPartNumber() );
>    qcExtent.sub(handle); // now contains extent of qc area
>    System.out.println("QC extents " + qcExtent + "for "+  mi.getPartNumber() );

>    // get the outer flat, add a border, and set scale for qc drawing
>    Drawing flatO = (Drawing) flatOutsideO;
>    Point3d lower =  flatO.getFeature("ORG_ANC_LL").getHandle();
>    Point3d upper =  flatO.getFeature("ORG_ANC_UR").getHandle();
>    BoundingBox qcFlat = new BoundingBox(lower, upper);
>    System.out.println("outside flat bounds " + qcFlat );
>    DxfFeature featureOutside = flatO.getSdp().extractEntriesByBounds(qcFlat);
>    DxfPrimitives dp = new DxfPrimitives();
>    // add outer border
>    double BORDER = 0;
>    lower.x -= BORDER;
>    lower.y -= BORDER;
>    upper.x += BORDER;
>    upper.y += BORDER;
>    Point3d other = new Point3d(lower);
>    other.x = upper.x;
>    final int PLACES = 3;
>    final String color = "7";
>    featureOutside.entitiesAdd(dp.dxfLine(3,lower, other, "BORDER", color, "CONTINUOUS", ""));
>    featureOutside.entitiesAdd(dp.dxfLine(3,other, upper, "BORDER", color, "CONTINUOUS", ""));
>    other.x = lower.x;
>    other.y = upper.y;
>    featureOutside.entitiesAdd(dp.dxfLine(3,upper, other, "BORDER", color, "CONTINUOUS", ""));
>    featureOutside.entitiesAdd(dp.dxfLine(3,other, lower, "BORDER",  color, "CONTINUOUS", ""));

>    System.out.println("outside flat bounds after border " + qcFlat + " " + lower + " " + upper );

>    // change color 
>    for (DxfEntry de: featureOutside.getDxfEntries()) {
>       if (de.isCode("62")) { // 62 = COLOR CODE
>          de.setValue("2"); // 2 = YELLOW
>       }
>       if (de.isCode(DxfPrimitives.LAYER_CODE)) {
>          de.setValue("OUTSIDE_SKIN");
>       }
>    }


>    // Calculate bounds of flat + border
>    Point3d extent = new Point3d(upper);
>    extent.sub(lower);
>    System.out.println("Outside flat extent " + extent + " for " +  mi.getPartNumber() + " " + lower + " " + upper);

>    double scaleX = qcExtent.x/ extent.x  ;
>    double scaleY = qcExtent.y/ extent.y ;
>    double scale = Math.min(scaleX, scaleY);
>    System.out.println("Scale is " + scale);
>//    double xOffset = (qcExtent.x - (extent.x * scale)) / 2.0;
>    double qcCenterX = handle.x + (qcExtent.x / 2.0);
>    double qcCenterY = handle.y + (qcExtent.y / 2.0);
>    System.out.println("QC Center is " + qcCenterX + " " + qcCenterY);
> //   if (xOffset > 0) {
> //      handle.x += xOffset;
> //   }
>    handle.x = qcCenterX - ((extent.x * scale) / 2.0);
>    handle.y = qcCenterY - ((extent.y * scale) / 2.0);

>    System.out.println("origin for outside flat in qc coords = " + handle);
>    featureOutside.setBounds(featureOutside.calculateBounds()); // reset bounds to account for border
>    featureOutside.zeroToLowerLeft();
>    Transform3D t = new Transform3D();
>    t.setTranslation(new Vector3d(handle.x, handle.y, handle.z)); // move the origin to the area 
>    t.setScale(new Vector3d(scale,scale,scale));
>    featureOutside.transform(t);

>   // add inside skin
>
>    Drawing flatI = (Drawing) flatInsideO;
>    lower =  flatI.getFeature("ORG_ANC_LL").getHandle();
>    Point3d lowerOrigin = new Point3d(lower); // save a copy
>    upper =  flatI.getFeature("ORG_ANC_UR").getHandle();
>    qcFlat = new BoundingBox(lower, upper);


>    BORDER = -.01; //just enoug so it will be in the bounds //-.692;
>    lower.x -= BORDER;
>    lower.y -= BORDER;
>    upper.x += BORDER;
>    upper.y += BORDER;
>    String savedLine = flatI.getState().getLineType();
>    flatI.getState().setLineType("PHANTOM");
>    flatI.addRectangle(lower, upper, "QC Border");
>    flatI.getState().setLineType(savedLine);


>    try {
>      DxfFeature featureInside = flatI.getSdp().extractEntriesByBounds(qcFlat);

>      // change color
>      for (DxfEntry de: featureInside.getDxfEntries()) {
>        if (de.isCode("62")) { // color code
>          de.setValue("3"); // 3 = green
>        }
>        if (de.isCode(DxfPrimitives.LAYER_CODE)) {
>          de.setValue("INSIDE_SKIN");
>        }
>      }
>      t = new Transform3D();
>      // center on x
>      extent = new Point3d(upper);
>      extent.sub(lower);
        
>      //handle.x = (qcExtent.x/ 2.0) + handleX - ((extent.x * scale) / 2.0);
>    //  handle.x = qcCenterX - ((extent.x * scale) / 2.0);
>      handle.x = qcCenterX - ((extent.x * scale) / 2.0);
>      handle.y = qcCenterY - ((extent.y * scale) / 2.0);
>      lowerOrigin.scale(scale);

>    //  featureInside.zeroToLowerLeft();
>      t.setTranslation(new Vector3d(handle.x - lowerOrigin.x, handle.y -  lowerOrigin.y, handle.z - lowerOrigin.z)); // move the origin to the area 
>      t.setScale(new Vector3d(scale,scale,scale)); 
>      featureInside.transform(t); // scale and move to same location as outer skin - this should work if the anchor points are valid
>
>      d.getSdp().entitiesAdd(featureInside.getDxfEntries());
>    } catch (Exception e) {
>        //eat it for now
>      e.printStackTrace();
>    }
>    d.getSdp().entitiesAdd(featureOutside.getDxfEntries());
>
>//    d.addCircle(new Point3d(qcCenterX, qcCenterY,0), .1,"center");

>    d.generate(why);
>    d.clearData();
>    flatO.clearData();
>    retract(flatO);
>    flatI.clearData();
>    retract(flatI);
>    insert(new RuleLink("drawingQCComplete", d, null));
> 

end


rule "manufacturing.panel.v2.drawings.door.qc.generate.20201025.01"
salience -3000
//
//  This rule creates the qc drawing, after the flat has completed
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>   materialA: ManufacturingFeature( name == "general.material.a"  ,                        parent == pparent)
>   materialB: ManufacturingFeature( name == "general.material.b"  ,                        parent == pparent)
>    orient:   ManufacturingFeature( name == "general.orientation"   , orientation: value,    parent == pparent)
> //             ManufacturingFeature( name == "general.hinge.location"   , hingeLocation: value,    parent == pparent)

>   RuleLink( name matches "(drawingToParentFlat.outswing.door.outside|drawingToParentFlat.inswing.door.noflange)",  b == pparent , flatOutsideO : a)
>   RuleLink( name == "drawingFlatComplete",  a == flatOutsideO)

>   RuleLink( name == "drawingToParentQC"  ,b == pparent,   qcO : a )

then

>   String why = drools.getRule().getName();
>
>    ManufacturedItem mi =  pparent;
>    WorkingMemory wm = drools.getWorkingMemory();
>    List<QualityEntry>  qel  = WorkspaceQuery.queryByParent( wm, "QualityEntryByParent", mi);
>    Drawing d = (Drawing) qcO;
>    d.readTemplateFromFile(why);
>    d.extractFeatures("PT_.*");
>    d.extractFeatures("ORG_.*");
>
>    Point3d handle =  d.getFeature("PT_TBL").getHandle();
>    SimpleDxfTable sdt = new SimpleDxfTable(d);
>    sdt.setColAWidth(4.0); // inches for name
>    sdt.setColBWidth(6.0); // inches for values
>   
>    sdt.generate(QualityEntry.condense(qel), handle);
>    
>    Point4d textOrigin = new Point4d(0,0,0,-.33);
>    handle =  d.getFeature("PT_PARTNUMBER").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.20;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( mi.getPartNumber(),  why);

>    String desc = materialA.getValue();
>    ManufacturingFeature gaugea = pparent.getOptionalFeature("general.gauge.a");
>    if (gaugea != null) {
>      desc = desc + " " + gaugea.getValue(); 
>    }
>
>    handle =  d.getFeature("PT_MTL_INSIDE").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.20;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( desc,  why);
>
>
>    desc = materialB.getValue();
>    ManufacturingFeature gaugeb = pparent.getOptionalFeature("general.gauge.b");
>    if (gaugeb != null) {
>      desc = desc + " " + gaugeb.getValue(); 
>    }

>    handle =  d.getFeature("PT_MTL_OUTSIDE").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.20;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( desc,  why);
>

>    if (d.getDrawingName().contains("inswing")) { 
>       // System.out.println("Flipping QC Image " +  mi.getPartNumber());
>        DrawingHelper.extractFeatureFromPointBounds(d,"ORG_BOUND_LL");
>        DxfFeature hingelatch = d.getFeature("ORG_BOUND_LL");
>        Transform3D t = new Transform3D();
>        t.setScale(new Vector3d(-1,1,1)); // flip the x axis
>        Point3d l = new Point3d();
>        Point3d u= new Point3d();
>        hingelatch.getBounds().getLower(l);
>        hingelatch.getBounds().getUpper(u);
>        t.setTranslation(new Vector3d( u.x ,0,0)); // move the origin
>        hingelatch.transform(t);
>        Point3d offset = new Point3d(l.x,0,0);
>        d.addFeature("ORG_BOUND_LL", offset, why);
>     }



>    handle =  d.getFeature("PT_REF").getHandle();
>    textOrigin.x = handle.x;
>    textOrigin.y = handle.y;
>    textOrigin.w = -.40;
>    d.getState().setTextOrigin( textOrigin );
>    d.addTextWithLineFeed( mi.getPartNumber(),  why);

>    d.generate(why);
>    d.clearData();
>    insert(new RuleLink("drawingQCComplete", d, null));
> 

end



rule "manufacturing.panel.v2.drawings.screwpattern.20090410.01"
when
     drawing matches "panel.v2.flat.outside"
>    countM:    ManufacturingFeature( countName: name matches "general.dim.[ab].screw.count",           pparent: parent)
>               RuleLink(             name == "drawingToParentFlat.outside",  a == drawing,  b == pparent )
>    spacingM:  ManufacturingFeature( spaceName: name matches "general.dim.[ab].screw.spacing"  ,       parent == pparent)
then
>   //TODO - validate first hole spacing?
>   // validate distance from first hole to edge matches last hole to edge?

>    String aOrb = countName.substring(12,13);
>    String nameAOrb = spaceName.substring(12,13);
>   // check for cross product
>    if (aOrb.equalsIgnoreCase(nameAOrb)) {
>      String why = drools.getRule().getName();
>      int count = Integer.parseInt(countM.getValue());
>      double spacing = spacingM.getDoubleValue();
>      String featureName = RuleHelper.pairMatch(";a;RPT_SCREW_002;b;RPT_SCREW_001",aOrb);
>      double xIncrement = 0;
>      double yIncrement = 0;
>      if (aOrb.equalsIgnoreCase("a")) {
>         xIncrement = spacing;
>      } else { // safe to use since pairMatch above already tested this to ensure a or b values
>         yIncrement = spacing;
>      }
>      String featureL = featureName +"_L";
>      String featureH = featureName +"_U";
>      Point3d location = new Point3d(0,0,0);
>      for (int x = 0; x < count; x++) {
>         drawing.addFeature(featureL, location, why);
>         drawing.addFeature(featureH, location, why);
>         location.x += xIncrement;
>         location.y += yIncrement;
>      }

>     insert(new QualityEntry(pparent, aOrb.toUpperCase() + " SCREW COUNT", count,0 ,150));
>     insert(new QualityEntry(pparent, aOrb.toUpperCase() + " SCREW SPACING", spacing,3 ,150));


>      System.out.println("Done adding to " + pparent);
>    }
end


// v2 has general.doorframe.bb.screw.firsthole, v1 does not have it

rule "manufacturing.panel.v2.drawings.doorframe.c.channel.h.screw.v2.20170909.01"
when
     drawing matches "panel.v2.flat.c.h"
>    ManufacturingFeature(  name ==  "feature.doorframe",  doorBound : value,    pparent: parent)
>                RuleLink( ln:  name matches "drawingToParentFlat.doorframe.c.h",  a == drawing,  b == pparent )
>    ManufacturingFeature(  name ==  "general.doorframe.a.screw.spacing",   screwSpace: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.a.screw.count",     screwCount: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.a.screw.firsthole", screwFirstA: doubleValue,    parent == pparent)

>    ManufacturingFeature(  name ==  "general.doorframe.hole.to.open",       openOffset: doubleValue,    parent == pparent)

>    ManufacturingFeature(  name ==  "general.doorframe.bb.screw.firsthole",     parent == pparent)

then
>      String why = drools.getRule().getName();
>      String featureName = "RPT_DOORFRAME";
>      Point3d handle =  drawing.getFeature(featureName).getHandle();
>      Point3d extents = drawing.getMaximumExtent(); // requires origin at 0,0,0
>      int holeCount = (int) Math.round(screwCount);
>      Point3d location = new Point3d(0,0,0);
>      location.x = screwFirstA - openOffset;
>      for (int x = 0; x < holeCount; x++) {
>         drawing.addFeature(featureName, location, why);
>         location.x += screwSpace;
>      }
>      System.out.println("Done adding h pattern to " + pparent);
end





