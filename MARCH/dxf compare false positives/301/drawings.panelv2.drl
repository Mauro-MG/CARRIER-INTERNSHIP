end


//Nov 27 2012 Bug 416 - Panel penetrations not matching MW VFD Bypass box on left hand panel
rule "manufacturing.panel.v2.drawings.penetration.pattern.vfd.bypass.mw.20121127.01"
//
//  This rule creates the penetration in the outside and inside skins.
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*PVFDB4.*" , parent == pparent  )
>         ManufacturingFeature( name == "general.bounds",  bounds: value  ,     parent == pparent)
>         ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.orientation"  , orientation: value, parent == pparent)

>         RuleLink( name ==  "drawingToParentFlat.outside",  drawingO: a,  b == pparent  )
>         RuleLink( name ==  "drawingToParentFlat.inside",  drawingInsideO: a,  b == pparent  )
then
>   System.out.println("Start processing pattern " + raw);
>   Drawing flat = (Drawing) drawingO;

>   String[] parts = raw.split("\\t");
>   double[] partsd = new double[parts.length];
>   for (int ndx=0; ndx < parts.length; ndx++) { 
>      try {
>         partsd[ndx] = Double.parseDouble(parts[ndx]);
>      } catch (java.lang.NumberFormatException nfe) {
>        //eat it, just eat it, it is expected on KEY and PATTERN
>      }
>   }
> //KEY	Pattern	X1	Y1	Y2	Y21	Y22	D	D1	D2	TZ	A	A1	A2
>   final int X = 0;
>   final int Y = 1;
>   final int KEY =2;
>   final int PATTERN =3;
>   final int X1 =4;
>   final int Y1 =5;
>   final int Y2 =6;
>   final int Y21 =7;
>   final int Y22 =8;
>   final int D =9;
>   final int D1 =10;
>   final int D2 =11;
>   final int TZ = 12;
>   final int A = 13;
>   final int A1 = 14;
>   final int A2 = 15;

>   if (parts.length < 16) {
>      throw new Exception("Failed to split raw into 16 parts " + raw + " " + parts.length);
>   }


>  // Only A, A1 an A2 need to be inverted for INVERTA orientations
>   if (orientation.equals("INVERTA")) {
>      for (int x = A; x <= A2; x++) {
>        partsd[x] *= -1.0;
>      }
>   }

>   Point3d offset = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flat);
>   System.out.println("OFFSET for pattern is " + offset);

>   double hx1 = partsd[X1] /2.0;
>   final double RADIUS = .2; // for a .4 diamter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);



>     // patterns is 4 here, then 1-3 holes below
>     flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);

>     flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);

> // 
>     for (int ndx=0; ndx < 3; ndx++) {
>       if (partsd[D + ndx] > .001) {
>            flat.addCircle(new Point3d(offset.x + partsd[A + ndx]    , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2 + ndx],0), partsd[D + ndx]/2.0,why);
>          flatIn.addCircle(new Point3d(offsetIn.x + partsd[A + ndx]  , offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2 + ndx],0), partsd[D + ndx]/2.0,why);
>       }
>     }


>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();
>   String pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".001", pt ,150));
>   String key = "TZ=" +partsd[TZ] + " X1="+ partsd[X1];  
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".002", key ,151));
>   key = "Y1="+ partsd[Y1]+ " Y2="+ partsd[Y2]+ " D="+ partsd[D]+ " A="+ partsd[A];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".003", key ,152));
>   key = "Y21="+ partsd[Y21]+ " D1="+ partsd[D1]+ " A1="+ partsd[A1];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".004", key ,153));
>   key = "Y22="+ partsd[Y22]+ " D2="+ partsd[D2]+ " A2="+ partsd[A2];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".005", key ,154));

end



/////// VFD FAN ARRAYS /////////////////////
// dual vfd
rule "manufacturing.panel.v2.drawings.penetration.pattern.vfd.dual.20140129.01"
//
//  This rule creates the penetration in the outside and inside skins.
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*P2V2M01.*" , parent == pparent  )
>         ManufacturingFeature( name == "general.bounds",  bounds: value  ,     parent == pparent)
>         ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.orientation"  , orientation: value, parent == pparent)

>         RuleLink( name ==  "drawingToParentFlat.outside",  drawingO: a,  b == pparent  )
>         RuleLink( name ==  "drawingToParentFlat.inside",  drawingInsideO: a,  b == pparent  )
then
>   System.out.println("Start processing pattern " + raw);
>   Drawing flat = (Drawing) drawingO;

>   String[] parts = raw.split("\\t");
>   double[] partsd = new double[parts.length];
>   for (int ndx=0; ndx < parts.length; ndx++) { 
>      try {
>         partsd[ndx] = Double.parseDouble(parts[ndx]);
>      } catch (java.lang.NumberFormatException nfe) {
>        //eat it, just eat it, it is expected on KEY and PATTERN
>      }
>   }
> // value="9.793 29.214 MOUNT.VFD2.15 P2V2M01 11.01 12.5 3.05 1 0.25 6.9" source="intersector.panel.with.2vfd.20130924.01" />
> //KEY	Pattern	X1	X2	Y1	Y2	D	TZ	A
>   final int X = 0;
>   final int Y = 1;
>   final int KEY =2;
>   final int PATTERN =3;
>   final int X1 =4;
>   final int X2 =5;
>   final int Y1 =6;
>   final int Y2 =7;
>   final int D =8;
>   final int TZ = 9;
>   final int A = 10;

>   if (parts.length < 11) {
>      throw new Exception("Failed to split raw into 11 parts " + raw + " " + parts.length);
>   }


>  // Nothing needs to be altered for INVERTA orientation. 

>   Point3d offset = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flat);
>   System.out.println("OFFSET for pattern is " + offset);

>   double hx1 = partsd[X1] /2.0;
>   double hx2 = partsd[X2] /2.0;
>   double ah = partsd[A] /2.0;
>   final double RADIUS = .2; // for a .4 diamter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);


>     // patterns is 4 here, then 2 holes below
>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);

>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);

>   if (hx2 > 0) {
>     flat.addCircle(new Point3d(offset.x - hx2                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx2                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx2                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx2                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>   }

>   flat.addCircle(new Point3d(offset.x + ah    , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x + ah  , offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/2.0,why);

>   flat.addCircle(new Point3d(offset.x - ah    , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x - ah  , offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/2.0,why);


>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();
>   String pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".001", pt ,150));
>   String key = "TZ=" +partsd[TZ] + " X1="+ partsd[X1];  
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".002", key ,151));
>   key = "Y1="+ partsd[Y1]+ " Y2="+ partsd[Y2]+ " D="+ partsd[D]+ " A="+ partsd[A];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".003", key ,152));

end


// MCP only 2 fan
rule "manufacturing.panel.v2.drawings.penetration.pattern.mcp.only.20140224.01"
//
//  This rule creates the penetration in the outside and inside skins.
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*P1V2M02.*" , parent == pparent  )
>         ManufacturingFeature( name == "general.bounds",  bounds: value  ,     parent == pparent)
>         ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.orientation"  , orientation: value, parent == pparent)

>         RuleLink( name ==  "drawingToParentFlat.outside",  drawingO: a,  b == pparent  )
>         RuleLink( name ==  "drawingToParentFlat.inside",  drawingInsideO: a,  b == pparent  )
then
>   System.out.println("Start processing pattern " + raw);
>   Drawing flat = (Drawing) drawingO;

>   String[] parts = raw.split("\\t");
>   double[] partsd = new double[parts.length];
>   for (int ndx=0; ndx < parts.length; ndx++) { 
>      try {
>         partsd[ndx] = Double.parseDouble(parts[ndx]);
>      } catch (java.lang.NumberFormatException nfe) {
>        //eat it, just eat it, it is expected on KEY and PATTERN
>      }
>   }
> //KEY	Pattern	X1	Y1	D1	D2	A1	B1	TZ	Y2	Y3
>   final int X = 0;
>   final int Y = 1;
>   final int KEY =2;
>   final int PATTERN =3;
>   final int X1 =4;
>   final int Y1 =5;
>   final int D1 =6;
>   final int D2 =7;
>   final int A1 =8;
>   final int B1 =9;
>   final int TZ =10;
>   final int Y2 =11;
>   final int Y3 = 12;

>   if (parts.length < 12) {
>      throw new Exception("Failed to split raw into 12 parts " + raw + " " + parts.length);
>   }

>  // Only A1 and B1 need to be inverted for INVERTA orientations
>   if (orientation.equals("INVERTA")) {
>      partsd[A1] *= -1.0;
>      partsd[B1] *= -1.0;
>   }

>   Point3d offset = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flat);
>   System.out.println("OFFSET for pattern is " + offset);

>   double hx1 = partsd[X1] /2.0;
>   final double RADIUS = .2; // for a .4 diamter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);



>     // patterns is 4 here, then 3 holes below
>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);

>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);

>// center hole
>   flat.addCircle(new Point3d(offset.x  , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x , offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);

>// right hole
>   flat.addCircle(new Point3d(offset.x +partsd[A1]  , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x  +partsd[A1], offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);

>// left hole
>   flat.addCircle(new Point3d(offset.x -partsd[B1]  , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y3],0), partsd[D2]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x  -partsd[B1], offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y3],0), partsd[D2]/2.0,why);


> // 


>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();
>   String pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".001", pt ,150));
>   String key = "TZ=" +partsd[TZ] + " X1="+ partsd[X1];  
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".002", key ,151));
>   key = "Y1="+ partsd[Y1]+ " Y2="+ partsd[Y2]+ " D1="+ partsd[D1]+ " A1="+ partsd[A1];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".003", key ,152));
>   key = "Y3="+ partsd[Y3]+ " D2="+ partsd[D2]+ " B1="+ partsd[B1];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".004", key ,153));

end



// VFD + MCP 
// coordinates in pattern are vfd pattern
// this pattern is different on the right vs the left
rule "manufacturing.panel.v2.drawings.penetration.pattern.vfd.mcp.20140129.01"
//
//  This rule creates the penetration in the outside and inside skins.
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*P1V2M01.*" , parent == pparent  )
>         ManufacturingFeature( name == "general.bounds",  bounds: value  ,     parent == pparent)
>         ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.orientation"  , orientation: value, parent == pparent)

>         RuleLink( name ==  "drawingToParentFlat.outside",  drawingO: a,  b == pparent  )
>         RuleLink( name ==  "drawingToParentFlat.inside",  drawingInsideO: a,  b == pparent  )
then
>   System.out.println("Start processing pattern " + raw);
>   Drawing flat = (Drawing) drawingO;

>   String[] parts = raw.split("\\t");
>   double[] partsd = new double[parts.length];
>   for (int ndx=0; ndx < parts.length; ndx++) { 
>      try {
>         partsd[ndx] = Double.parseDouble(parts[ndx]);
>      } catch (java.lang.NumberFormatException nfe) {
>        //eat it, just eat it, it is expected on KEY and PATTERN
>      }
>   }
> //KEY	Pattern	A	D	TZ	XA	XB	X1	X2	Y1	Y2	Y3	YZ
>   final int X = 0;
>   final int Y = 1;
>   final int KEY =2;
>   final int PATTERN =3;
>   final int A =4;
>   final int D =5;
>   final int TZ =6;
>   final int XA =7;
>   final int XB =8;
>   final int X1 =9;
>   final int X2 =10;
>   final int Y1 =11;
>   final int Y2 = 12;
>   final int Y3 = 13;
>   final int YZ = 14;

>   if (parts.length < 14) {
>      throw new Exception("Failed to split raw into 14 parts " + raw + " " + parts.length);
>   }

>  // 
>   if (orientation.equals("INVERTA")) {
>     partsd[A] *= -1.0;
>   }

>   Point3d offset = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flat);
>   System.out.println("OFFSET for pattern is " + offset);

>   double hx1 = partsd[X1] /2.0;
>   double hx2 = partsd[X2] /2.0;
>   final double RADIUS = .2; // for a .4 diamter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);

> // offset if from center of vfd which is center of X1

>     // patterns is 4 here for vfd, 4 for mcp, then 2 holes below
>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);

>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);

>    // 4 for mcp
>   flat.addCircle(new Point3d(offset.x - hx2 + partsd[XB]      , offset.y -partsd[TZ]-partsd[Y1] - partsd[YZ] ,0)  , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx2 + partsd[XB]      , offset.y -partsd[TZ]-partsd[Y1] - partsd[YZ] ,0)  , RADIUS,why);

>   flat.addCircle(new Point3d(offset.x - hx2 + partsd[XB]      , offset.y -partsd[TZ]-partsd[Y1] - partsd[YZ] + partsd[Y2] ,0)  , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx2 + partsd[XB]      , offset.y -partsd[TZ]-partsd[Y1] - partsd[YZ] + partsd[Y2] ,0)  , RADIUS,why);


>// right hole
>   flat.addCircle(new Point3d(offset.x +partsd[XB]     , offset.y -partsd[TZ]-partsd[Y1] - partsd[YZ] - partsd[Y3] ,0), partsd[D]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x +partsd[XB] , offsetIn.y -partsd[TZ]-partsd[Y1] - partsd[YZ] - partsd[Y3],0), partsd[D]/2.0,why);

>// right right hole (was left hole, moved to right per drawing change)
>   flat.addCircle(new Point3d(offset.x +partsd[XB]+partsd[A]     , offset.y -partsd[TZ]-partsd[Y1] - partsd[YZ] - partsd[Y3] ,0), partsd[D]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x +partsd[XB]+ partsd[A] , offsetIn.y -partsd[TZ]-partsd[Y1] - partsd[YZ] - partsd[Y3],0), partsd[D]/2.0,why);

> // 


>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();
>   String pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x + partsd[XB] /2.0, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".001", pt ,150));
>   String key = "TZ=" +partsd[TZ] + " X1="+ partsd[X1];  
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".002", key ,151));
>   key = "Y1="+ partsd[Y1]+ " Y2="+ partsd[Y2]+ " D="+ partsd[D]+ " A="+ partsd[A];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".003", key ,152));
>   key = "Y3="+ partsd[Y3]+ " XB="+ partsd[XB]+ " X2="+ partsd[X2];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".004", key ,153));
>   key = "YZ="+ partsd[YZ];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".005", key ,153));
end



rule "manufacturing.panel.v2.drawings.penetration.pattern.mcp.4or6fan.20160407.01"
//
//  This rule creates the penetration in the outside and inside skins.
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*MOUNT\\.M[NW]\\.MCP.*" , parent == pparent  )
>         ManufacturingFeature( name == "general.bounds",  bounds: value  ,     parent == pparent)
>         ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.orientation"  , orientation: value, parent == pparent)

>         RuleLink( name ==  "drawingToParentFlat.outside",  drawingO: a,  b == pparent  )
>         RuleLink( name ==  "drawingToParentFlat.inside",  drawingInsideO: a,  b == pparent  )
then
>   System.out.println("Start processing pattern " + raw);
>   Drawing flat = (Drawing) drawingO;
>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();

>   String[] parts = raw.split("\\t");
>   double[] partsd = new double[parts.length];
>   for (int ndx=0; ndx < parts.length; ndx++) { 
>      try {
>         partsd[ndx] = Double.parseDouble(parts[ndx]);
>      } catch (java.lang.NumberFormatException nfe) {
>        //eat it, just eat it, it is expected on KEY
>      }
>   }
>   final int X = 0;  // center of box
>   final int Y = 1;  // top of box
>  // final int KEY =2;
>   final int X1 =3; 
>   final int Y1 =4;
>   final int Y2 =5;
>   final int A1 =6;
>   final int D1 =7;
>  // final int OFFSETX = 8; // assumes centered
>   final int OFFSETY = 9;
>   final int HOLECOUNT = 10;
>   final int Y3 = 11;
>   final int B1 =12;
>   final int D2 =13;


>   if (parts.length < 14) {
>      throw new Exception("Failed to split raw into 14 parts " + raw + " " + parts.length);
>   }

>  // Only A1 and B1 need to be inverted for INVERTA orientations
>   if (orientation.equals("INVERTA")) {
>      partsd[A1] *= -1.0;
>      partsd[B1] *= -1.0;
>   }

>   Point3d offset = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y]+partsd[OFFSETY], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flat);
>   System.out.println("OFFSET for pattern is " + offset);

>   double hx1 = partsd[X1] /2.0;
>   final double RADIUS = .2; // for a .4 diamter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y]+partsd[OFFSETY], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);


>     // patterns is 4 here, then 2 to 4 holes below
>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y ,0)            , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y ,0)            , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[Y1],0) , RADIUS,why);
>   flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[Y1],0) , RADIUS,why);

>   String pt;
>   pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x  - hx1, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, "RIVNUTF", pt ,150));
>   pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x  + hx1, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, "RIVNUTF", pt ,150));
>   pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x  - hx1, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-partsd[Y1]-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, "RIVNUTF", pt ,150));
>   pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x  + hx1, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-partsd[Y1]-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, "RIVNUTF", pt ,150));




>// center hole (always)
>   flat.addCircle(new Point3d(offset.x  , offset.y -partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x , offsetIn.y -partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>   String qcname;
>   qcname = makeConduitName(partsd[D1]);
>   pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x , 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y-partsd[Y1]-partsd[Y2], 3)  ;
>   insert(new QualityEntry(pparent, qcname, pt ,150));


>// right hole (always) +A1
>   flat.addCircle(new Point3d(offset.x +partsd[A1]  , offset.y -partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>   flatIn.addCircle(new Point3d(offsetIn.x  +partsd[A1], offsetIn.y -partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>   pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x +partsd[A1] , 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y-partsd[Y1]-partsd[Y2], 3)  ;
>   insert(new QualityEntry(pparent, qcname, pt ,150));





>// left hole (only if holecount == 3) -A1
>   if (parts[HOLECOUNT].equals("3")) {
>     flat.addCircle(new Point3d(offset.x -partsd[A1]  , offset.y -partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>     flatIn.addCircle(new Point3d(offsetIn.x  -partsd[A1], offsetIn.y -partsd[Y1]-partsd[Y2],0), partsd[D1]/2.0,why);
>     pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x -partsd[A1] , 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y-partsd[Y1]-partsd[Y2], 3)  ;
>     insert(new QualityEntry(pparent, qcname, pt ,150));
>   }
> // VFD feed hole B1, Y3, D2
>   if ((partsd[Y3] > .0001) || (partsd[Y3] < .0001)) {
>     flat.addCircle(new Point3d(offset.x -partsd[B1]  , offset.y -partsd[Y1]-partsd[Y3],0), partsd[D2]/2.0,why);
>     flatIn.addCircle(new Point3d(offsetIn.x  -partsd[B1], offsetIn.y -partsd[Y1]-partsd[Y3],0), partsd[D2]/2.0,why);
>     qcname = makeConduitName(partsd[D2]);
>     pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x -partsd[B1] , 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y-partsd[Y1]-partsd[Y3], 3)  ;
>     insert(new QualityEntry(pparent, qcname, pt ,150));
>   }

> // 


end




rule "manufacturing.panel.v2.drawings.penetration.pattern.vfd2.4or6fan.20160415.01"
//
//  This rule creates the penetration in the outside and inside skins.
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*46MOUNT\\.VFD2.*" , parent == pparent  )
