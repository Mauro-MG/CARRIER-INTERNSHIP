>      partsd[A] *= -1.0;
>   }


>   double hx1 = partsd[X1] /2.0;
>   final double RADIUS = .2; // for a .4 diamter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);



>   if (parts[PATTERN].contains("3")) {// figure 3 has a different pattern
>     double x3 = partsd[X3];
>     // pattern 3 has 13 holes. 8 here, 5 common below
>     flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx1 - x3           , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
