// check for panel a pipe hole too close to the edge of a panel. Reduce radius if needed to a provided eng limit.
// no asserts for large reduction nor bad input conditions
// sends radius adjusted and radius original to the next rule
rule "manufacturing.panel.v2.drawings.coil.radius.20201025.01"
when
>  fMf: ManufacturingFeature(  featureName: name matches "feature.coil_.*",  hBounds: value,    pparent: parent)
>       ManufacturingFeature(  name ==  "general.bounds",  bounds: value  ,     parent == pparent)
>       ManufacturingFeature(  name ==  "general.dim.a.axis",  aAxis: value,    parent == pparent)
>       ManufacturingFeature(  name ==  "general.dim.b.axis",  bAxis: value,    parent == pparent)
then
>   BoundingBox panelBounds = BoundingBoxUtil.convertStringToBox(bounds);
>   BoundingBox holeBounds = BoundingBoxUtil.convertStringToBox(hBounds);

> // The featureName field contain the hole diameter
>   int first = featureName.indexOf("_") + 1;
>   String diameterString = featureName.substring(first).replaceAll("_",".");
>   double diameter = Double.parseDouble(diameterString);
>   
>   final double LIMIT = .6; // min distance between panel general.bounds and edge of the pipe hole.
>   
>   Point3d pl = new Point3d();
>   Point3d pu = new Point3d();
>   panelBounds.getLower(pl);
>   panelBounds.getUpper(pu);

>   Point3d hl = new Point3d();
>   Point3d hu = new Point3d();
>   holeBounds.getLower(hl);
>   holeBounds.getUpper(hu);
>
>   double shrink = 0;

>   int ndxs[] = { getAxisNdx(aAxis),  getAxisNdx(bAxis) };
>   double lowHole=0;
>   double upperHole=0;
>   double lowPanel=0;
>   double upperPanel=0;
>   for (int n : ndxs) {
>     lowHole = getPointByNdx(hl,n);
>     upperHole = getPointByNdx(hu,n);
>     lowPanel = getPointByNdx(pl,n);
>     upperPanel = getPointByNdx(pu,n);
>     double halfAdder = (diameter - (upperHole - lowHole)) / 2.0;
>     lowHole -= halfAdder;
>     upperHole += halfAdder;
>     if ( (upperPanel - upperHole)  < LIMIT) {
>       shrink = Math.max(shrink,upperHole - (upperPanel - LIMIT));
>     }
>     if ( (lowHole - lowPanel ) < LIMIT) {
>       shrink = Math.max(shrink,lowPanel + LIMIT - lowHole);
>     }
>   }

>   double radius = (shrink > .01) ? (diameter-shrink) / 2.0 : diameter / 2.0;
>   // return results in a point
>   // x = desired radius
>   // y = calculated radius (use this one for drawing hole)
>   Point3d results = new Point3d( diameter / 2.0, radius,0);

>   insert(new RuleLink("HOLERADIUS", fMf , results));
end



// HOLERADIUS a = feature.coil_.* ManufacturingFeature, b= Point3d(desired radius, dxf radius, ignore)
// always draw a circle instead of sometimes a circle sometimes a feature placement
rule "manufacturing.panel.v2.drawings.coil.20201025.01"
when
       drawing matches "(panel.v2.flat.inside|panel.v2.flat.outside)"
>               RuleLink(  name matches  "drawingToParentFlat.*",  a == drawing,  pparent : b )
>  fMf: ManufacturingFeature(  featureName: name matches "feature.coil_.*", bounds: value, parent == pparent)
>               RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
>               RuleLink(  name == "HOLERADIUS",  a  == fMf,  radiusPointO:  b )
then
>   Point3d center = BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds));
>   transformsPoint( (Transform3D[]) transformO, center);

>   Point3d radius = (Point3d) radiusPointO;
>   drawing.addCircle(new Point3d(center.x , center.y,0), radius.y , drools.getRule().getName());
>   String pt = qCFormatXY(drawing, center);
>   if (pt != null) {
>     // adjusted or not?
>     String name = (Math.abs(radius.x-radius.y) < 0.01) ? featureName.substring(8).toUpperCase() : "ADJUSTED COIL D=" + Rounding.roundToPrettyString(radius.y * 2.0, 3);
>     insert(new QualityEntry((ManufacturedItem) pparent, name, pt,200));
>   }
end


rule "manufacturing.panel.v2.drawings.raw.rectangle.hole.20201025.01"
when
     drawing matches "panel.v2.*"
>    ManufacturingFeature(  name ==  "feature.raw.rectangle",  bounds : value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.(inside|outside)",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
>    ManufacturingFeature(  name ==  "general.raw.hole.to.open",       openOffset: doubleValue,    parent == pparent)
then
>   BoundingBox rectangleBounds = BoundingBoxUtil.convertStringToBox(bounds);
>   Point3d center = BoundingBoxUtil.getCenter(rectangleBounds);
>   rectangleBounds = BoundingBoxUtil.alterBounds(rectangleBounds, new Point3d(-openOffset,-openOffset,-openOffset), new Point3d(openOffset,openOffset,openOffset));
>   transformsPoint( (Transform3D[]) transformO, center);
>   transformsBoundingBox( (Transform3D[]) transformO,rectangleBounds);
>   Point3d l = new Point3d();
>   Point3d u = new Point3d();
>   rectangleBounds.getLower(l);
>   rectangleBounds.getUpper(u);
>   drawing.addRectangle(l, u, drools.getRule().getName());
>   String pt = qCFormatXY(drawing, center);
>   if (pt != null) {
>     insert(new QualityEntry(pparent, "RECTHOLE", pt,200));
>     insert(new QualityEntry(pparent, "RECTHOLE H", Rounding.roundToPrettyString(u.y-l.y, 3),200));
>     insert(new QualityEntry(pparent, "RECTHOLE W", Rounding.roundToPrettyString(u.x-l.x, 3),200));
>   }
end


rule "manufacturing.panel.v2.drawings.raw.circle.hole.20210127.01"
when
     drawing matches "panel.v2.*"
>    ManufacturingFeature(  name ==  "feature.raw.circle",  bounds : value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.(inside|outside)",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
then
>   BoundingBox cBounds = BoundingBoxUtil.convertStringToBox(bounds);
>   Point3d center = BoundingBoxUtil.getCenter(cBounds);
>   transformsPoint( (Transform3D[]) transformO, center);
>   transformsBoundingBox( (Transform3D[]) transformO,cBounds);
>   Point3d l = new Point3d();
>   Point3d extents = new Point3d();
>   cBounds.getLower(l);
>   cBounds.getUpper(extents);
>   extents.sub(l);
>   double dims[] = {extents.x, extents.y, extents.z};
>   Arrays.sort(dims);
>   if (Math.abs(dims[2]-dims[1]) >1) {
>      throw new Exception("feature.raw.circle is not a circle " + bounds);  
>   }
>   Point3d c = new Point3d(center);
>   drawing.addCircle(c, dims[2]*.5, drools.getRule().getName());
>   String pt = qCFormatXY(drawing, center);
>   if (pt != null) {
>     int diameter = (int) Math.floor(dims[2]);
>     insert(new QualityEntry(pparent, "CIRCLE_"+ diameter + "_" + (Math.round((dims[2] - diameter) *100)), pt,200));
>   }
end




