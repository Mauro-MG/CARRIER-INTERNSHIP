rule "manufacturing.panel.v2.drawings.hingepattern.20090412.01"
when
     drawing matches "panel.v2.outswing.door.flat.(inside|outside)"
>    RuleLink( nm: name matches "drawingToParentFlat.outswing.door.(inside|outside)",  a == drawing,  pparent :b  )     
>    ManufacturingFeature( name == "general.hinge.count"   ,  hingeCount : doubleValue, parent == pparent)
>    ManufacturingFeature( name == "general.hinge.spacing" ,  spacing  :  doubleValue, parent == pparent)
>             
then
>   ManufacturedItem mi = (ManufacturedItem) pparent;
>   System.out.println("Adding hinges to " + drawing.getDrawingName() + " " + nm + " " + mi.getPartNumber()); 
>   //TODO - validate first hole spacing?
>   // validate distance from first hole to edge matches last hole to edge?

>      String why = drools.getRule().getName();
>      String featureName = "RPT_HINGE_001_L";
>      Point3d location = new Point3d(0,0,0);
>      int count = (int) Math.round(hingeCount);
>      for (int x = 0; x < count; x++) {
>         drawing.addFeature(featureName, location, why);
>         location.y += spacing;
>      }
>      if (drawing.getDrawingName().matches(".*outside")) {
>        insert(new QualityEntry(mi, "HINGE COUNT", hingeCount, 0 ,150));
>        insert(new QualityEntry(mi, "HINGE SPACING", spacing, 3  ,150));
>      }

>      System.out.println("Done adding to " + pparent);
end






