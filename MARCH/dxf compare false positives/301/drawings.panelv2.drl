rule "manufacturing.panels.v2.perforated.qc.entry.20180702.01"
when
>    ManufacturingFeature( name == "general.classification", value == "PANEL.V2" , pparent : parent )
>    RuleLink(name == "PERFVERSION", b == pparent, aasString == "V2")
then
>    insert(new QualityEntry(pparent, "PERFORATED", "see 39MA40002400 and FLATS" ,150));
end


rule "manufacturing.panels.v2.perforated.qc.too.small.entry.20171208.01"
when
>    ManufacturingFeature( name == "general.classification", value == "PANEL.V2" , pparent : parent )
>    RuleLink(name == "PERFVERSION", b == pparent, aasString == "V2")
>  mff: ManufacturingFeature( name == "feature.noperf"                          , parent == pparent)
then
>    mff.incrementUsage();
>    insert(new QualityEntry(pparent, "PERFORATED" , "TOO SMALL FOR PERF", 301));
end


// Takes perf plate rectangle feature,  adds channels and bounds to workspace


rule "manufacturing.panel.v2.features.perfrectangle.20180611.01"
when
     drawing matches "panel.v2.flat.inside"
>    mff:    ManufacturingFeature( name == "feature.perfrectangle", boundStr : value,  pparent: parent)
>            ManufacturingFeature( name == "general.bounds", gboundStr : value,  parent == pparent)
>            ManufacturingFeature( name == "general.orientation"   , orientation: value,    parent == pparent)
>            ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>            ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)

>            RuleLink(name == "PERFVERSION", b == pparent, aasString == "V2") // not really needed since we have the feature.perfrectangle

>            RuleLink(name == "drawingToParentFlat.inside",  a == drawing,  b == pparent )
then
>    String why = drools.getRule().getName();

>    mff.incrementUsage();

>    // perfrectangle bounds coordinates are relative to open space
>    // x is width of panel
>    // y is height of panel
>    // z is depth of panel

>    BoundingBox pb = BoundingBoxUtil.convertStringToBox( gboundStr );
>    Point3d pu = new Point3d();
>    Point3d pl = new Point3d();
>    pb.getLower(pl);
>    pb.getUpper(pu);


>    Point3d panelOpeningCenter = center(pb);

>    panelOpeningCenter.sub(pl); // now it is all relative to the opening


>    BoundingBox b = BoundingBoxUtil.convertStringToBox( boundStr ); // perf rectangle in opening offset dimensions
>    Point3d u = new Point3d();
>    Point3d l = new Point3d();
>    b.getLower(l);
>    b.getUpper(u);


> //   if (invertY(aAxis, bAxis)) {  // top and bottom
> //      l.y = pu.y - l.y;
> //      u.y = pu.y - u.y;
> //      double swap = l.y;
> //      l.y = u.y;
> //      u.y = swap;
> //   }

> /*
>    // right side X Y, left size -X Y
>    // inlet 
>    if (invertX(aAxis, bAxis)) {
>       l.y = pu.y - l.y;
>       u.y = pu.y - u.y;
>       double swap = l.y;
>       l.y = u.y;
>       u.y = swap;
>    }

> */

>   boolean isInlet = ( (aAxis.equalsIgnoreCase("Y")) && (bAxis.equalsIgnoreCase("Z")) && (orientation.equals("STANDARD")) );
>   boolean isTopBottom = ( (aAxis.equalsIgnoreCase("X")) && (bAxis.equalsIgnoreCase("Z")) );

> // l.y is relative to the panel bounds

>   if (isInlet || isTopBottom) { // inlet usage: invert Y axis using Z extent
>       l.y = pu.z - pl.z - l.y;
>       u.y = pu.z - pl.z - u.y;
>       // now flip them
>       double swap = l.y;
>       l.y = u.y;
>       u.y = swap;
>   }






>    b = new BoundingBox(l,u);

>    Drawing d = (Drawing) drawing; //inside drawing
>    Point3d maxExtent = drawing.getMaximumExtent();
>    Point3d flatCenter = center(new BoundingBox(drawing.getMinimumExtent(), maxExtent)); // assume flat has 0,0 origin
>    Point3d perfCenter = center(b);

>  System.out.println("flat center  perf " + pparent.getPartNumber() + " " + flatCenter);
>  System.out.println("perf center  perf " + pparent.getPartNumber() + " " + perfCenter);
>  System.out.println("panel center perf " + pparent.getPartNumber() + " " + panelOpeningCenter);
>    


>   // add 4 dimples to mark the corners
>  //  Point3d offset = new Point3d(perfCenter.x - flatCenter.x, perfCenter.y - flatCenter.y, 0);
>   Point3d offset = new Point3d(flatCenter.x - panelOpeningCenter.x , flatCenter.y- panelOpeningCenter.y, 0);
>   if (aAxis.equals("X") && bAxis.equals("Z")) {
>      offset = new Point3d(flatCenter.x - panelOpeningCenter.x , flatCenter.y- panelOpeningCenter.z, 0);
>   }
>   if (aAxis.equals("Y") && bAxis.equals("Z")) {
>      offset = new Point3d(flatCenter.x - panelOpeningCenter.y , flatCenter.y- panelOpeningCenter.z, 0);
>   }

>  System.out.println("offset    " + pparent.getPartNumber() + " " + offset);

>    Point3d dimple = new Point3d(l);
>    dimple.add(offset);


>    drawDimple(dimple, d, why); // lower left

>    dimple.x = u.x;
>    dimple.y = l.y;
>    dimple.z = 0;
>    dimple.add(offset);
>    drawDimple(dimple, d, why); // lower right

>    dimple.x = u.x;
>    dimple.y = u.y;
>    dimple.z = 0;
>    dimple.add(offset);
>    drawDimple(dimple, d, why); // upper right

>    dimple.x = l.x;
>    dimple.y = u.y;
>    dimple.z = 0;
>    dimple.add(offset);
>    drawDimple(dimple, d, why); // upper left


>   // todo adjust the l and u for end/top/side panel positions?
>    BoundingBox plate = new BoundingBox(l,u);
>    List channels = makeLinesV2(plate);

>    insert(new RuleLink("PERF.PANEL.OUTSIDELINES", channels, drawing));

>    insert(new RuleLink("PANEL.PERF.OUTERBOUNDS", plate, drawing));

> System.out.println("channels = " + channels);
> System.out.println("perf plate = " + b);

end     




// creates perf plate drawing
// plates are already inverted
rule "manufacturing.panel.v2.perforated.plate.20180702.01"
when
>    RuleLink(name == "PERF.PANEL.OUTSIDELINES", outsideLinesAlteredO : a, drawingf :b)
>    RuleLink(name == "PANEL.PERF.OUTERBOUNDS", obO: a, b == drawingf)

>    inBucket:     RuleFlag( name == "IN_BUCKET");
>    outBucket:    RuleFlag( name == "OUT_BUCKET");

>    drawing: Drawing(drawingName == "panel.v2.flat.inside", this == drawingf)
>    RuleLink( name == "drawingToParentFlat.inside", pparentO : b , a == drawing)   

then
> // make sure  lines are for this perf plate
> //System.out.println("A");
>  List<BoundingBox> allLines = (List<BoundingBox>) outsideLinesAlteredO;
>  BoundingBox perfBounds = (BoundingBox) obO;

>  if (perfBounds.intersect(allLines.get(0))) {
>    String why = drools.getRule().getName();
>    ManufacturedItem pparent = (ManufacturedItem) pparentO;
>    String partnumber = pparent.getPartNumber();

>    Point3d centerOuter = center(perfBounds);
>    Point3d l = new Point3d();
>    Point3d u = new Point3d();
>    perfBounds.getLower(l);
>    perfBounds.getUpper(u);


>    Drawing d = new Drawing("panel.v2.flat.perf.v2");
>    d.setTemplateFilename(inBucket.getValue() + "/perfplatev2.dxf" , why);
>    String filename = outBucket.getValue() + "/" +  partnumber +
>         "_A" + String.format("%03d", Math.round(l.x)) + 
>         "_B" + String.format("%03d", Math.round(l.y)) + 
>         "_perfplate_flat.dxf";
>    d.setOutputFilename(filename , why);

>    d.readTemplateFromFile(why);
>    d.zeroDrawingLowerLeft(why);
>    d.extractFeatures("DIM_.*");
>    d.extractFeatures("ORG_SFM.*");

>    List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>    if (dims.size() != 2) {
>      throw new Exception("Failed to find two DIM_ entries in flat std_screwpanel_perf_flat.dxf found " + dims.size());
>    }
>    Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);
>    double dimA = dimMap.get("A").doubleValue();
>    double dimB = dimMap.get("B").doubleValue();
>
>  // now get the spindle fold mutilate points
>    DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>    DxfFeature sfmB = d.getFeature("ORG_SFM_DIM_B");
>    double sfmAx = sfmA.getHandle().x; 
>    double sfmBy = sfmB.getHandle().y; 
>
>
>   // now scale the flat
>    d.alterDimensionY( (u.y-l.y)- dimB,  sfmBy, Double.POSITIVE_INFINITY);
>    d.alterDimensionX( (u.x-l.x)- dimA,  sfmAx, Double.POSITIVE_INFINITY);
>

>   // Add to QC
>    final int PLACES = 3;
> // moved    insert(new QualityEntry(pparent, "PERFORATED", "see 39MA40002400" ,150));

> //System.out.println("B");

>   // extract the repeating patterns ONLY after the scale
>    d.extractFeatures("RPT_.*");

> //System.out.println("C");
>    List<DxfFeature> dflr = d.getFeatureNames("RPT_.*");
>    if (dflr.size() > 0) {
> //System.out.println("D");
>    d.generate("InterimTest");
>      DrawingHelper.extractFeatureFromPointBounds(d,"RPT_.*");
>    }
> //System.out.println("E");
>    d.zeroFeatures("RPT_PERFMTG_001.*", new Point3d(0,0,0), true, false); // zero x and not y
>    d.zeroFeatures("RPT_PERFMTG_002.*", new Point3d(0,0,0), false, true); // not x  and zero y

> //System.out.println("F");

>   // extract the bounds and anchor points  ONLY after the scale
>    d.extractFeatures("BOUND_.*");
>    d.extractFeatures("ORG_.*");

>   // center the pattern
>    Point3d maxExtent = d.getMaximumExtent();
>    Point3d minExtent = d.getMinimumExtent();
>    

> //System.out.println("G");
> 
>    List<BoundingBox> perfliner = new ArrayList<BoundingBox>();
>
>    for (BoundingBox line : allLines) {
>      BoundingBoxOrientation bbo = BoundingBoxOrientation.getLargestOrientation(line);
>      double length = bbo.getLength(line);
>      double[] pattern = perfPattern(length);
>      boolean xDone = false;
>      boolean yDone = false;
>      if ((bbo == BoundingBoxOrientation.X) && (!xDone)) {
>        xDone =true;
>        String featureName = "RPT_PERFMTG_001";
>        String featureL = featureName +"_L";
>        String featureH = featureName +"_U";
>        Point3d location = new Point3d();
>        double origin = ((maxExtent.x - minExtent.x) - length) * .5;
>        for (Double x : pattern) {
>          location.x = origin + x;
>          d.addFeature(featureL, location, why);
>          d.addFeature(featureH, location, why);
>        }
>      } else if ((bbo == BoundingBoxOrientation.Y) && (!yDone)) {
>        xDone =true;
>        String featureName = "RPT_PERFMTG_002";
>        String featureL = featureName +"_L";
>        String featureH = featureName +"_U";
>        Point3d location = new Point3d();
>        double origin = ((maxExtent.y - minExtent.y) - length) * .5;
>        for (Double x : pattern) {
>          location.y = origin + x;
>          d.addFeature(featureL, location, why);
>          d.addFeature(featureH, location, why);
>        }
>        
>      } // don't assert since we have 2 x and 2 y
>    }
> 
>    d.generate(why);
>    insert(d);
>    insert(new RuleLink("drawingToParentFlat.perf.plate", d, pparent));
>    // don't set a link for flat complete as that will assign the wrong material

>  } // intersect
end






// creates channel flats
// flats are already inverted

rule "manufacturing.panel.v2.perforated.channels.20180111.01"
when
>   RuleLink(name == "PERF.PANEL.OUTSIDELINES", outsideLinesAlteredO : a, drawing :b)

>   inBucket:     RuleFlag( name == "IN_BUCKET");
>   outBucket:    RuleFlag( name == "OUT_BUCKET");

>   draw: Drawing(drawingName == "panel.v2.flat.inside", this == drawing)
>   RuleLink( name == "drawingToParentFlat.inside", pparentO : b , a == drawing)   

then
>  // now we make each channel flat

>    ManufacturedItem pparent = (ManufacturedItem) pparentO;
>    String partnumber = pparent.getPartNumber();

>    DxfFeature anchor  = draw.getFeature("ORG_ANC_LL");
>    double lx  = anchor.getHandle().x; 
>    double ly  = anchor.getHandle().y; 


>    String why = drools.getRule().getName();
>    List<BoundingBox> channels = new ArrayList<BoundingBox>();
>    List<BoundingBox> outsideLines = (List<BoundingBox>) outsideLinesAlteredO;
>    System.out.println("Create channels outside" + outsideLines );
>    channels.addAll(outsideLines);

>    String templateName = "perfchannelv2.dxf";
>    String drawingName  = "panel.v2.perf.channel";
>    BoundingBoxOrientation BBOX = BoundingBoxOrientation.X;
>    BoundingBoxOrientation BBOY = BoundingBoxOrientation.Y;
>    for (BoundingBox line: channels) {
>      BoundingBoxOrientation lineO = BoundingBoxOrientation.getLargestOrientation(line);
>      double length = lineO.getLength(line);

>      int x = channels.indexOf(line);
>      Drawing d = new Drawing(drawingName);
>      d.setTemplateFilename(inBucket.getValue() + "/" + templateName, why);
>      String filename = outBucket.getValue() + "/" +  partnumber + 
>         "_A" + String.format("%03d", Math.round(BBOX.getLower(line) -lx)) + 
>         "_B" + String.format("%03d", Math.round(BBOY.getLower(line) -ly)) + 
>         "_" + lineO.getName() + 
>         "_"+ String.format("%03d",x+1) +
>         "_flat.dxf";
>      d.setOutputFilename(filename , why);
>      System.out.println("create channel for " + line + " " + filename);
>      d.readTemplateFromFile(why);
>      d.zeroDrawingLowerLeft(why);
>      d.extractFeatures("DIM_.*");
>      d.extractFeatures("ORG_SFM.*");

>      d.extractFeatures("FTR_.*"); 
>      List<DxfFeature> dfl = d.getFeatureNames("FTR_.*");

>      DrawingHelper.extractFeatureFromPointBounds(d,"FTR_.*");
>      d.zeroFeatures("FTR_.*", new Point3d(0,0,0), true, false); // zero x, not y

>      List<DxfFeature> dims = d.getFeatureNames("DIM_.*");
>      if (dims.size() != 1) {
>        throw new Exception("Failed to find 1 DIM_ entries in flat " + templateName + " found " + dims.size());
>      }

>      Map<String,Double> dimMap = DxfFeature.parseFeaturesToDimensions(dims);

>      double flatLength = dimMap.get("LENGTH").doubleValue();
>
>    // now get the spindle fold mutilate points
>      DxfFeature sfmA = d.getFeature("ORG_SFM_DIM_A");
>      double sfmAx = sfmA.getHandle().x; 

>   // now scale the flat a 
>      d.alterDimensionX(length - flatLength,  sfmAx, Double.POSITIVE_INFINITY);

>   // now lets add the features
>      double hits[] = perfPattern(length);
>      for (double hit: hits) {
>        d.addFeature("FTR_PLATE-ENG" , new Point3d(hit,0 ,0), why);
>        d.addFeature("FTR_PANEL-CLR" , new Point3d(hit,0 ,0), why);
>      }

>      d.generate(why); // do it, jerky.
>      insert(d);
>      insert(new RuleLink("drawingToParentFlat.perf.channel", d, pparent));
>      // don't set a link for flat complete as that will assign the wrong material
>   }

end



rule "manufacturing.panel.v2.drawings.bom.perf.flat.20180702.01"
//
//  This rule creates the bom entry for the perf flat
//
when
>  p: ManufacturingFeature( name == "general.classification", value == "PANEL.V2" , pparent : parent )

>   RuleLink( name matches "drawingToParentFlat.*", b == pparent ,  flatO: a)
>   drawing: Drawing( drawingName  == "panel.v2.flat.perf.v2", this == flatO)

>   RuleLink( name == "bomToParent" , b == pparent, bom: a)
then
>   String dName = drawing.getDrawingName();
>   double qty = 1;
>    // assumes drawing starts at 0,0
>   Point3d extent = drawing.getMaximumExtent();
>   final int PLACES =4;
>   extent.x = Rounding.round(extent.x, PLACES);
>   extent.y = Rounding.round(extent.y, PLACES);
>   extent.z = 0;
>   BillOfMaterial bomChild = new BillOfMaterial(BillOfMaterial.PURPOSE_DYNAMIC, null, "Flat " + extent.x  + " x " + extent.y ,
>           "GALVANIZED PERF (VA03-56)", "22", new File(drawing.getOutputFilename()).getName() , qty, 
>           new BoundingBox( new Point3d(), extent));
>   ((BillOfMaterial) bom).addChild(bomChild);

>   drawing.clearData();
end

rule "manufacturing.panel.v2.drawings.bom.channel.flat.20180702.01"
//
//  This rule creates the bom entry for the perf channel flats
//
when
>  p: ManufacturingFeature( name == "general.classification", value == "PANEL.V2" , pparent : parent )

>   RuleLink( name matches "drawingToParentFlat.*", b == pparent ,  flatO: a)
>   drawing: Drawing( drawingName  == "panel.v2.perf.channel", this == flatO)

>   RuleLink( name == "bomToParent" , b == pparent, bom: a)
then
>   String dName = drawing.getDrawingName();
>   double qty = 1;
>    // assumes drawing starts at 0,0
>   Point3d extent = drawing.getMaximumExtent();
>   final int PLACES =4;
>   extent.x = Rounding.round(extent.x, PLACES);
>   extent.y = Rounding.round(extent.y, PLACES);
>   extent.z = 0;
>   BillOfMaterial bomChild = new BillOfMaterial(BillOfMaterial.PURPOSE_DYNAMIC, null, "Flat " + extent.x  + " x " + extent.y ,
>           "GALVANIZED (VA03-56)", "22", new File(drawing.getOutputFilename()).getName() , qty, 
>           new BoundingBox( new Point3d(), extent));
>   ((BillOfMaterial) bom).addChild(bomChild);

>   drawing.clearData();
end

