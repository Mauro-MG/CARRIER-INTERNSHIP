>      String featureName = "RPT_DOORFRAME_S3";
>      Point3d handle =  drawing.getFeature(featureName).getHandle();
>      Point3d extents = drawing.getMaximumExtent(); // requires origin at 0,0,0
>      Point3d location = new Point3d(0,screwFirst,0);
>      drawing.addFeature(featureName, location, why); // add at bottom
>      location.y = extents.y - screwFirst;
>      drawing.addFeature(featureName, location, why); // add at top
>      System.out.println("Done adding v pattern to " + pparent);
end





