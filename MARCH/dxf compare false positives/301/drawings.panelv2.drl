rule "manufacturing.panel.v2.drawing.liner.20171222.01"
when
>    p:          ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>                RuleLink(name == "DRAWING.TRIGGERED", a == pparent)  // only generate for triggered drawings

>                ManufacturingFeature( name == "general.gauge.b"  , value == "24/24"       , parent == pparent) // this is the flag we need a liner drawing
>    outBucket:  RuleFlag( name == "OUT_BUCKET")
then
>    String why = drools.getRule().getName();

>    Drawing d = new Drawing("panel.v2.liner");
>    d.createDefaultDrawing();
>    d.setOutputFilename(outBucket.getValue() + "/" +  pparent.getPartNumber() + "_liner.dxf" , why);
>    insert(d);
>    insert(new RuleLink("drawingToParentLiner", d, pparent));
end



rule "manufacturing.panel.v2.drawings.liner.generate.20171221.01"
salience -2000
//
//  This rule creates the liner drawing, after the flat has completed
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )

>   RuleLink( name == "drawingToParentFlat.outside" || name == "drawingToParentFlat.inswing.door.flange" ,  b == pparent,   flatOutsideO: a )

>   RuleLink( name == "drawingFlatComplete",  a == flatOutsideO)

>   RuleLink( name == "drawingToParentLiner"  ,  linerO : a , b == pparent)

>   RuleLink( name == "TIPA", tipa : aasDouble, b == pparent)
>   RuleLink( name == "TIPB", tipb : aasDouble, b == pparent)
then
>    String why = drools.getRule().getName();
>
>    Drawing d = (Drawing) linerO;

>    System.out.println("Generating liner " + d.getDrawingName() + " " + d.getOutputFilename());


> ////////////////////// TRANSFER FEATURES FROM FLANGE FLAT TO LINER ////////////////////////
>    Drawing flatO = (Drawing) flatOutsideO;
>    String filename = flatO.getOutputFilename();
>    Point3d lower =  new Point3d(flatO.getFeature("ORG_ANC_LL").getHandle());
>    Point3d upper =  new Point3d(flatO.getFeature("ORG_ANC_UR").getHandle());
>    Point3d offset = new Point3d(.5,.5,0); // offset to avoid the perimeter screw holes, unfortunately the liner screw holes are not centered on the flange screw holes
>    lower.add(offset);
>    upper.sub(offset);
>    // Calculate bounds of flat + border
>    Point3d center = new Point3d(upper);
>    center.sub(lower);
>    center.scaleAdd(.5,lower);
>    double w = tipa - (0.057*2.0);
>    double h = tipb - (0.057*2.0);
>    d.addRectangle(new Point3d(), new Point3d(w,h,0), why);

>    BoundingBox flat = new BoundingBox(lower, upper);
>    Drawing flatTemp = new Drawing("temp");
>    flatTemp.setTemplateFilename(filename,"readit");
>    flatTemp.readTemplateFromFile("readit");

>    double wc = w *.5;
>    double hc = h *.5;

>    try {
>       DxfFeature featureOutside = flatTemp.getSdp().extractEntriesByBounds(flat); // this will throw an exception if there is nothing found
>       DxfPrimitives dp = new DxfPrimitives();
>       // change color 
>       for (DxfEntry de: featureOutside.getDxfEntries()) {
>          if (de.isCode("62")) { // 62 = COLOR CODE
>             de.setValue("4"); 
>          }
>          if (de.isCode(DxfPrimitives.LAYER_CODE)) {
>             de.setValue("LINER");
>          }
>       }
>    
>       System.out.println("Outside flat center " + center + " for " +  pparent.getPartNumber() + " " + lower + " " + upper);
>       Transform3D t = new Transform3D();
>       t.setTranslation(new Vector3d(wc-center.x, hc-center.y, 0)); // move the origin to the area 
>       featureOutside.transform(t);
>       d.getSdp().entitiesAdd(featureOutside.getDxfEntries());
>    } catch (Exception e) {
>        System.out.println("Exception e - ok when no features found");
>        e.printStackTrace();
>    }


> ////////////////////// SCREW HOLES ////////////////////////
>    // add screws if needed, like spacer logic
>    // 
>   // calculate extents
>    Point3d flatLow    = d.getMinimumExtent();
>    Point3d flatUpper  = d.getMaximumExtent();
>    Point3d extent = new Point3d(flatUpper);
>    extent.sub(flatLow);

>    String aOrB[] = { "a", "b", };
>    for (String letter : aOrB) {
>        // get on rhs...
>        String countS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.count", false); // false = don't increment usage
>        String spaceS = getOptionalManufacturingFeature(pparent, "general.dim."+letter+".screw.spacing", false);
>        int count = 0;
>        if (countS.length() > 0) {
>          count = Integer.parseInt(countS);
>        }
>        double space = 0;
>        if (spaceS.length() > 0) {
>          space = Double.parseDouble(spaceS);
>        }
>        double dim = extent.x;
>        if (letter.equals("b")) {
>          dim = extent.y;
>        }

>        if (count > 0) {
>          final double radius = 0.625 *.5;
>          double patternLength = space * (count -1.0);
>          double poffset = (dim - patternLength) *.5;
>          Point3d circleL = new Point3d(flatLow.x + poffset, flatLow.y   + .316,0);  // assume dim a
>          Point3d circleU = new Point3d(flatLow.x + poffset, flatUpper.y - .316,0);  // assume dim a
>          if (letter.equals("b")) {
>            circleL = new Point3d(flatLow.x + .316,   flatLow.y + poffset,0); 
>            circleU = new Point3d(flatUpper.x - .316, flatLow.y + poffset,0); 
>          }
>          for (int x = 1; x <= count; x++) {
>            d.addCircle(circleL, radius, why);
>            d.addCircle(circleU, radius, why);
>            if (letter.equals("a")) {
>              circleL.x += space;
>              circleU.x += space;
>            } else {
>              circleL.y += space;
>              circleU.y += space;
>            }
>          } // for x
>        } // if count > 0
>
>    } // for letter

>    flatTemp.clearData();
>    insert(new RuleLink("linerCHAIN",  d, null));
end



rule "manufacturing.panel.v2.drawings.liner.adjust.rectangles.20180109.01"
//
//  This rule enlarges rectangles in the liner drawing
//
when
>    RuleLink(name == "linerCHAIN",  linerO: a)
then
>  String why = drools.getRule().getName();
>  Drawing d = (Drawing) linerO;
>  System.out.println("Enlarge rectangles, if any " + d.getDrawingName() + " " + d.getOutputFilename());
>
>  SimpleDxfParser sdp = d.getSdp();
>  DxfPrimitives primitive = new DxfPrimitives();
>  int start = sdp.findStartOfEntitiesIndex();

>  DxfEntry e;
>  Point3d p;
>  Point3d q;
>  BoundingBox b;

>  Point3d maxExtent = new Point3d(d.getMaximumExtent()); // new may not be needed - safer to do it
>  Point3d minExtent = new Point3d(d.getMinimumExtent());
>  Point3d offset = new Point3d(.5, .5, 0); // don't take anything within .5 from the extents. .5 was a guess to exclude the perimeter
>  maxExtent.sub(offset);
>  minExtent.add(offset);
>  BoundingBox contents = new BoundingBox(minExtent, maxExtent);


>  List<BoundingBox> lineList = new ArrayList<BoundingBox>();

>  List<DxfEntry> pairs = sdp.getDxfEntries();
>  for (int ndx = start; ndx < pairs.size(); ndx++) {
>     e = pairs.get(ndx);
>     if (e.isCode(DxfPrimitives.NEW_OBJECT_CODE)) {
>         if (e.getValue().compareToIgnoreCase(DxfPrimitives.END_SECTION) == 0) {
>            break;
>         } else if (e.getValue().compareToIgnoreCase("LINE") == 0) {
>            p = sdp.getPoint(sdp.findEntry(ndx + 1, DxfPrimitives.X1_CODE), sdp.findEntry(ndx + 1, DxfPrimitives.Y1_CODE), sdp.findEntry(ndx + 1, DxfPrimitives.Z1_CODE));
>            q = sdp.getPoint(sdp.findEntry(ndx + 1, DxfPrimitives.X2_CODE), sdp.findEntry(ndx + 1, DxfPrimitives.Y2_CODE), sdp.findEntry(ndx + 1, DxfPrimitives.Z2_CODE));
>            if (q.distance(p) > 1) { // line is longer that 1"  (1" was pulled from the air - long enough to prevent dimple line manipulation, short enough to capture all rectangles)
>               b = createBoundsFromLine(minExtent, p, q);
>               if (contents.intersect(b)) {
>                  //System.out.println("Keeping  line " + b + " contents " + contents);
>                  lineList.add(new BoundingBox(p,q));  
>               } else {
>                  //System.out.println("Skipping line " + b + " contents " + contents);
>               }
>            }
>         }
>     }
>  }

> // lineList contains list of lines to investigate
> // find centerpoint of rectangles, expand up, down, right left by .125
> // break into connecting sequences
> // big cross product - few lines to check - brute force

> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> // for first pass- just check for size = 4 or 0. Throw exception on any other line counts
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
> /////////////////////////////////////////////////////////////////////////
>  if (lineList.size() == 4) { // one rectangle
>     BoundingBox all = null;
>     for (BoundingBox l : lineList) {
>         System.out.println("adding line to all " + l + " " + all);
>         if (all == null) {
>           all = new BoundingBox(l);
>         } else {
>           all.combine(l);
>         }
>     }

>    System.out.println("all " + all);
>    // get center and extents
>    Point3d ll = new Point3d();
>    Point3d ur = new Point3d();
>    all.getLower(ll);
>    all.getUpper(ur);

>    final double SHIFTAMOUNT = .125;
>    final double DELTA = 0.01; // large enough to find the line
>    final double EXTENT = .1;  // large enough to find the line - needs to be greater than DELTA
>    ll.sub(new Point3d(DELTA, DELTA,0));
>    ur.add(new Point3d(DELTA, DELTA,0));
>    ll.z = -.1;
>    ur.z = .1;  // enough to trigger intersections with 0 z


>    {
>     // upper right corner
>      BoundingBox target = new BoundingBox(new Point3d(ur.x - EXTENT, ur.y - EXTENT, ll.z), ur);
>      System.out.println("Altering target : " + target );
>      sdp.alterDimensionByBounds(target, new Point3d(SHIFTAMOUNT, SHIFTAMOUNT, 0));
>    }

>    {
>     // lower right corner
>      BoundingBox target = new BoundingBox(new Point3d(ur.x - EXTENT, ll.y , ll.z), new Point3d(ur.x, ll.y + EXTENT , ur.z));
>      System.out.println("Altering target : " + target );
>      sdp.alterDimensionByBounds(target, new Point3d(SHIFTAMOUNT, -SHIFTAMOUNT, 0));
>    }

>    {
>     // upper left corner
>      BoundingBox target = new BoundingBox(new Point3d(ll.x, ur.y - EXTENT , ll.z), new Point3d(ll.x + EXTENT, ur.y, ur.z));
>      System.out.println("Altering target : " + target );
>      sdp.alterDimensionByBounds(target, new Point3d(-SHIFTAMOUNT, SHIFTAMOUNT, 0));
>    }

>    {
>     // lower left corner
>      BoundingBox target = new BoundingBox(ll, new Point3d(ll.x + EXTENT, ll.y + EXTENT , ur.z));
>      System.out.println("Altering target : " + target );
>      sdp.alterDimensionByBounds(target, new Point3d(-SHIFTAMOUNT, -SHIFTAMOUNT, 0));
>    }

>  } else if (lineList.isEmpty()) {
>    // do nothing
>  } else {
>    throw new Exception("Too many rectangles on liner " + lineList.size() + " " + lineList);
>  }


>  d.generate(why);
>  insert(new RuleLink("drawingFlatComplete",  d, null));
end









rule "manufacturing.panel.v2.drawings.bom.liner.flat.20171222.01"
//
//  This rule creates the bom entry for the liner flat
//
when
>   RuleLink( name == "drawingToParentLiner"  ,  linerO : a , pparent : b)
>   RuleLink( name == "drawingFlatComplete",  a == linerO)
>   RuleLink( name == "bomToParent" , b == pparent, bom: a)
then
>   Drawing drawing = (Drawing) linerO;
>   String dName = drawing.getDrawingName();
>   double qty = 1;
>    // assumes drawing starts at 0,0
>   Point3d extent = drawing.getMaximumExtent();
>   final int PLACES =4;
>   extent.x = Rounding.round(extent.x, PLACES);
>   extent.y = Rounding.round(extent.y, PLACES);
>   extent.z = 0;
>   BillOfMaterial bomChild = new BillOfMaterial(BillOfMaterial.PURPOSE_DYNAMIC, null, "Flat " + extent.x  + " x " + extent.y ,
>           "GALVANIZED (VA03-56)", "24", new File(drawing.getOutputFilename()).getName() , qty, 
>           new BoundingBox( new Point3d(), extent));
>   ((BillOfMaterial) bom).addChild(bomChild);

>   drawing.clearData();
end
















rule "manufacturing.panel.v2.drawings.viewport.20201025.01"
when
     drawing matches "panel.v2.*"
>    ManufacturingFeature(  name ==  "feature.viewport",  bounds: value,    pparent: parent)
>                RuleLink(  name matches  "(drawingToParentFlat.outswing.door.(inside|outside)|drawingToParentFlat.inswing.door.(noflange|flange))",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
then
>   Point3d center = BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds));
>   transformsPoint( (Transform3D[]) transformO, center);
>   drawing.addFeature("FTR_VIEWPORT", center, drools.getRule().getName());

>   // just add qc entry for outside skin hole
>   if (drawing.getDrawingName().contains("outside") || (drawing.getDrawingName().contains("flange") && (!drawing.getDrawingName().contains("noflange")))) {
>     String pt = formatXYStr(drawing, center);
>     insert(new QualityEntry(pparent, "VIEWPORT", pt,200));
>   }
end


// this is drawn as a rectangle so we did not have to touch all the panel flats
rule "manufacturing.panel.v2.drawings.viewportnarrow.20201025.01"
when
     drawing matches "panel.v2.*"
>    ManufacturingFeature( fn: name =="feature.viewportnarrow" ,  bounds: value,    pparent: parent)
>                RuleLink(  name matches  "(drawingToParentFlat.outswing.door.(inside|outside)|drawingToParentFlat.inswing.door.(noflange|flange))",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
then
>   Point3d center = BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds));
>   // center of a 5.27 x 8.15 rectangle per 39ma40052400 r M.3
>   Point3d l = new Point3d();
>   Point3d u = new Point3d();
>   final double hx = 5.27 *.5;
>   final double hy = 8.15 *.5;
>   l.x = center.x - hx; 
>   u.x = center.x + hx;
>   l.y = center.y - hy;
>   u.y = center.y + hy;
>   transformsPoint( (Transform3D[]) transformO, l);
>   transformsPoint( (Transform3D[]) transformO, u);
>   drawing.addRectangle(l, u, drools.getRule().getName());

>   // just add qc entry for outside skin hole
>   if (drawing.getDrawingName().contains("outside") || (drawing.getDrawingName().contains("flange") && (!drawing.getDrawingName().contains("noflange")))) {
>     String pt = formatXYStr(drawing, center);
>     insert(new QualityEntry(pparent, "VIEWPORTNARROW", pt,200));
>   }
end





rule "manufacturing.panel.v2.drawings.flat.inside.generate.20090414.01"
//
//  This rule creates the flat for the inside only
//  It needs to run prior to the perf flat
//
salience -900   // run this rule ALMOST last
when
     drawing matches "panel.v2.flat.inside"
>    RuleLink(  name matches  "drawingToParentFlat.*",  a == drawing,  pparent : b )
>    ManufacturingFeature( name == "general.orientation"   , orientation: value,    parent == pparent)     
then
>    System.out.println("Generating drawing " + drawing.getDrawingName() + " " + drawing.getOutputFilename() + " " + orientation);
>    drawing.resetHandles();

>    drawing.generate(drools.getRule().getName()); 
>    insert(new RuleLink("drawingFlatComplete", drawing, null));
end


rule "manufacturing.panel.v2.drawings.flat.generate.20180702.01"
//
//  This rule creates the flat
//
salience -1000   // run this rule last
when
     drawing matches "panel.v2.*flat.*"
>    RuleLink(  name matches  "drawingToParentFlat.*",  a == drawing,  pparent : b )
>    ManufacturingFeature( name == "general.orientation"   , orientation: value,    parent == pparent)     
     
then
>    String drawingNam = drawing.getDrawingName();
>    if (!drawingNam.matches("panel.v2.flat.inside") && !drawingNam.matches("panel.v2.flat.perf.v2")) {
>      System.out.println("Generating drawing " + drawingNam + " " + drawing.getOutputFilename());
>      drawing.resetHandles();
>      drawing.generate(drools.getRule().getName()); 
>      insert(new RuleLink("drawingFlatComplete", drawing, null));
>    }
end


















/////
/////
///////////////
/////
/////


// goes on both inside and outside flats
// Fine line, not really, if this BREAKS rule of not calculating dimensions in the drawing module
// feature.doorframe bounds is the desired channel framed opening
// rectangular hole in inside skin is a larger than the opening by general.doorframe.hole.to.open
// 

rule "manufacturing.panel.v2.drawings.inswing.door.frame.hole.v2.20201026.01"
when
     drawing matches "panel.v2.*"
>    ManufacturingFeature(  name ==  "feature.doorframe",  doorBound : value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.(inside|outside)",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)
>    ManufacturingFeature(  name ==  "general.bounds",  bounds: value  ,     parent == pparent)
>    ManufacturingFeature(  name ==  "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.dim.b.axis",  bAxis: value,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.hole.to.open",       openOffset: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.hole.to.open.outside", openOffsetOutside: doubleValue,    parent == pparent) // new for Sept 2017
>    ManufacturingFeature(  name ==  "general.doorframe.edge.to.screw",      edgeOffset: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.edge.to.screw.tbi",   edgeOffsetTbi: doubleValue,    parent == pparent) // new for Sep 2017 - used for horizontal screw pattern inside the unit - avoids interference with the larger top/bottom flange of the door
>    ManufacturingFeature(  name ==  "general.doorframe.a.screw.spacing",   screwSpaceA: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.a.screw.count",     screwCountA: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.a.screw.firsthole", screwFirstA: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.b.screw.spacing",   screwSpaceB: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.b.screw.count",     screwCountB: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.b.screw.firsthole", screwFirstB: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.bb.screw.spacing",   screwSpaceBB: doubleValue,    parent == pparent)// new for Sept 2017
>    ManufacturingFeature(  name ==  "general.doorframe.bb.screw.count",     screwCountBB: doubleValue,    parent == pparent)// new for Sept 2017
>    ManufacturingFeature(  name ==  "general.doorframe.bb.screw.firsthole", screwFirstBB: doubleValue,    parent == pparent)// new for Sept 2017
>    ManufacturingFeature(  name ==  "general.doorframe.b.cornerhole",       cornerHole: doubleValue,    parent == pparent)// new for Sept 2017
>    ManufacturingFeature(  name ==  "general.doorframe.hinge.offset.y",   hingeOffsetY: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.hinge.offset.x",   hingeOffsetX: doubleValue,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.doorframe.latch.offset.x",   latchOffsetX: doubleValue,    parent == pparent)// new for Sept 2017
>    ManufacturingFeature(  name ==  "general.doorframe.latch",   latch: value  ,    parent == pparent)  
> //   ManufacturingFeature(  name ==  "general.orientation",   orient: value ,    parent == pparent) 
then
> // asserts
>   if (!aAxis.equalsIgnoreCase("X")) {
>      throw new Exception("inswing door on panel with a axis not X " + aAxis);
>   }
>   if (!bAxis.equalsIgnoreCase("Y")) {
>      throw new Exception("inswing door on panel with b axis not Y " + aAxis);
>   }

>   boolean inside = drawing.getDrawingName().contains("inside");
>   if (!inside && !drawing.getDrawingName().contains("outside")) {
>      throw new Exception("Unknown door frame name not inside outside but [" +drawing.getDrawingName() +"]");
>   }

>   String why = drools.getRule().getName();
>   BoundingBox doorBounds = BoundingBoxUtil.convertStringToBox(doorBound);
>   Point3d center = BoundingBoxUtil.getCenter(doorBounds);
>   transformsPoint( (Transform3D[]) transformO, center);

>  // l and u are based on the inside skin flat bounds
>   Point3d l = new Point3d();
>   Point3d u = new Point3d();
>   doorBounds.getLower(l);
>   doorBounds.getUpper(u);
>   Point3d extents = new Point3d(u);
>   extents.sub(l);


>   Point3d fl = new Point3d();
>   Point3d fu = new Point3d();

>   l.x -= openOffset;
>   u.x += openOffset;
>   l.y -= openOffset;
>   u.y += openOffset;

>   Point3d a = new Point3d();
>   Point3d b = new Point3d();
>   BoundingBox tempB;
>   if (inside) {
>      tempB = new BoundingBox(l,u);
>      transformsBoundingBox( (Transform3D[]) transformO, tempB);
>      Point3d tl = new Point3d();
>      Point3d tu = new Point3d();
>      tempB.getLower(tl);
>      tempB.getUpper(tu);
>      drawing.addRectangle(tl, tu, why);
>   } else  { // outside
>      // let's draw the radius box
>      double radius = 3.5;  // may change below
>      Point3d ll = new Point3d(l);
>      Point3d uu = new Point3d(u);
>      // l and u already have openOffset cooked into them
>      ll.x += openOffsetOutside + openOffset;
>      ll.y += openOffsetOutside + openOffset;
>      uu.x -= openOffsetOutside + openOffset;
>      uu.y -= openOffsetOutside + openOffset;

>      final double MINLINELENGTH = .25;
>      if ( (uu.x - ll.x) < (2 * radius + MINLINELENGTH)) {
>          radius = 2.5;
>      }

>      BoundingBox roundedBox = new BoundingBox(ll,uu);
>      transformsBoundingBox( (Transform3D[]) transformO, roundedBox);
>      // transform should ensure new boundingbox is normal (lower is lower than upper)
>      roundedBox.getLower(fl);
>      roundedBox.getUpper(fu);
>  


> // we are adding constants to flat coordinates, but we transformed the bounds so lower should be lower
> // descriptions ASSUME unit x = flat x, unitY = flat Y (may be flipped for non side usage in the future)
>      a.x = fl.x + radius;
>      a.y = fl.y;
>      b.x = fu.x - radius;
>      b.y = fl.y;
>      drawing.addLine(a , b , "bottom horizontal line");

>      a.x = fl.x + radius;
>      a.y = fu.y;
>      b.x = fu.x - radius;
>      b.y = fu.y;
>      drawing.addLine(a , b , "top horizontal line");

>      Point3d c = new Point3d();

>      // arc in lower left
>      c.x = fl.x + radius;
>      c.y = fl.y + radius; 
>      drawing.getSdp().entitiesAdd(generateArcEntities(drawing, c, radius,180, 270, "Arc in Lower Left"));
>      // arc in lower right
>      c.x = fu.x - radius;
>      c.y = fl.y + radius; 
>      drawing.getSdp().entitiesAdd(generateArcEntities(drawing, c, radius,270, 0, "Arc in Lower Right"));
>      // arc in upper left
>      c.x = fl.x + radius;
>      c.y = fu.y - radius; 
>      drawing.getSdp().entitiesAdd(generateArcEntities(drawing, c, radius,90, 180, "Arc in Upper Left"));

>      // arc in upper right
>      c.x = fu.x - radius;
>      c.y = fu.y - radius; 
>      drawing.getSdp().entitiesAdd(generateArcEntities(drawing, c, radius,0, 90, "Arc in Upper Left"));

>      a.x = fl.x ;
>      a.y = fl.y + radius;
>      b.x = fl.x ;
>      b.y = fu.y - radius ;
>      drawing.addLine(a , b , "lowX vertical");

>      a.x = fu.x ;
>      a.y = fl.y + radius;
>      b.x = fu.x ;
>      b.y = fu.y - radius ;
>      drawing.addLine(a , b , "upperX vertical");
>   }


> // now add the FTR_DOORFRAME holes around the opening
> // horizontal is the same on both inside and outside skins "A" pattern
> // Across the top and bottom of the door frame 

>   double effectiveEdgeOffset = (inside) ? edgeOffsetTbi : edgeOffset;

>   a.set(l);
>   b.set(u);
>   a.x += screwFirstA;
>   a.y -= effectiveEdgeOffset;
>   b.x -= screwFirstA; // last hole offset
>   b.y += effectiveEdgeOffset;
>   tempB = new BoundingBox(a,b);
>   transformsBoundingBox( (Transform3D[]) transformO, tempB);
>   tempB.getLower(fl);
>   tempB.getUpper(fu);

>   String featureName = "FTR_DOORFRAME";
>   int count = (int) Math.round(screwCountA);
>   Point3d locationH = new Point3d(fl.x , fu.y,0);
>   Point3d locationL = new Point3d(fl.x , fl.y,0);
>   for (int x = 0; x < count; x++) {
>         drawing.addFeature(featureName, locationH, why);
>         drawing.addFeature(featureName, locationL, why);
>         locationH.x += screwSpaceA;
>         locationL.x += screwSpaceA;
>   }
>   if (inside) {
>     {
>       String pt = "COUNT=" +  count + "  SPACING=" + Rounding.roundToPrettyString(screwSpaceA, 3)  ;
>       insert(new QualityEntry(pparent, "DOORFRAME A", pt,201));
>     }
>   }

> // now add the right and left sides of the door frame
>   double screwCountVertical[] = {screwCountB, screwCountBB};
>   double screwFirstVertical[] = {screwFirstB, screwFirstBB};
>   double screwSpacingVertical[] = {screwSpaceB, screwSpaceBB};
>   int ndx = (inside) ? 0 : 1; 

>   a.set(l);
>   b.set(u);
>   a.x -= edgeOffset;
>   a.y += screwFirstVertical[ndx];
>   b.x += edgeOffset;
>   b.y -= screwFirstVertical[ndx];
>   tempB = new BoundingBox(a,b);
>   transformsBoundingBox( (Transform3D[]) transformO, tempB);
>   tempB.getLower(fl);
>   tempB.getUpper(fu);

> // patterns are symmetrical with same firstHole offset at top and bottom, so they maybe placed last to first or first to last, both ok.
>   count = (int) Math.round(screwCountVertical[ndx]);
>   locationL = new Point3d(fl.x , fl.y,0);
>   locationH = new Point3d(fu.x , fl.y,0);
>   for (int x = 0; x < count; x++) {
>         drawing.addFeature(featureName, locationH, why);
>         drawing.addFeature(featureName, locationL, why);
>         locationH.y += screwSpacingVertical[ndx];
>         locationL.y += screwSpacingVertical[ndx];
>   }

>   if (inside) {
>       String pt = "COUNT=" +  count + "  SPACING=" + Rounding.roundToPrettyString(screwSpacingVertical[ndx], 3)  ;
>       insert(new QualityEntry(pparent, "DOORFRAME B", pt,201));
>   } else {
>       String pt = "COUNT=" +  count + "  SPACING=" + Rounding.roundToPrettyString(screwSpacingVertical[ndx], 3)  ;
>       insert(new QualityEntry(pparent, "DOORFRAME B1", pt,201));
>   }

>   // there are 4 static holes for the inside skin
>   if (inside) {
>     a.set(l);
>     b.set(u);
>     a.x -= edgeOffset;
>     a.y += cornerHole;
>     b.x += edgeOffset;
>     b.y -= cornerHole;
>     tempB = new BoundingBox(a,b);
>     transformsBoundingBox( (Transform3D[]) transformO, tempB);
>     tempB.getLower(fl);
>     tempB.getUpper(fu);
     
>     locationL = new Point3d(fl.x  , fl.y,0);
>     locationH = new Point3d(fu.x  , fl.y,0);
>     drawing.addFeature(featureName, locationH, why);
>     drawing.addFeature(featureName, locationL, why);
>     locationL.y = fu.y;
>     locationH.y = fu.y;
>     drawing.addFeature(featureName, locationH, why);
>     drawing.addFeature(featureName, locationL, why);
>   }


>  // define where the hinges and latch features go
>    boolean hingeLowX = !latch.equals("LOW");
>    boolean hingeUpperX = !latch.equals("HIGH");
>    if (!hingeLowX && !hingeUpperX) {
>       throw new Exception("Unknown hinge location " + latch);
>    }
>    if (hingeLowX && hingeUpperX) {
>       throw new Exception("Unknown hinge location " + latch);
>    }

>   if (inside) {
> // now do the hinges offset
>     featureName = "FTR_HINGE";
>     if (hingeLowX) {
>        a.set(l);
>        a.x -= hingeOffsetX;
>        b.set(a);
>     } else { // hinge upper x (safe due to asserts)
>        a.set(u);
>        a.x += hingeOffsetX;
>        b.set(a);
>     }
>     a.y = l.y + hingeOffsetY;
>     b.y = u.y - hingeOffsetY;
>     transformsPoint( (Transform3D[]) transformO, a);
>     transformsPoint( (Transform3D[]) transformO, b);
>     drawing.addFeature(featureName, a, why);
>     drawing.addFeature(featureName, b, why);
>     {
>       String pt = "HINGEX=" +  Rounding.roundToPrettyString((a.x - center.x), 3) + "  HINGEY=" + Rounding.roundToPrettyString(hingeOffsetY, 3)  ;
>       insert(new QualityEntry(pparent, "DOORFRAME", pt,202));
>     }
>   }

>   // just add qc entry for outside skin hole
>   if (!inside) {
>     Point3d origin =  drawing.getFeature("ORG_ANC_LL").getHandle();
>     {
>       String pt = formatXYStr(drawing, center);
>       insert(new QualityEntry(pparent, "DOORFRAME", pt,200));
>     }
>     {
>       String pt = "W=" +  Rounding.roundToPrettyString(extents.x+ openOffset*2.0, 3) + "  H=" + Rounding.roundToPrettyString(extents.y+ openOffset*2.0, 3) + "  WC=" + Rounding.roundToPrettyString(extents.x, 3)  + "  HC=" + Rounding.roundToPrettyString(extents.y, 3)  ;
>       insert(new QualityEntry(pparent, "DOORFRAME", pt ,200));
>     }
>   }

>   // door latches, hinges FTR_INSWINGLATCH - needs to be added to ntb and tb outside skins
>   
>   if (!inside) {
> // now do the latches
>     featureName = "FTR_INSWINGLATCH";
>     if (hingeLowX) {
>        a.set(u);
>        a.x += latchOffsetX;
>        b.set(a);
>     } else { 
>        a.set(l);
>        a.x -= latchOffsetX;
>        b.set(a);
>     }
>     a.y = l.y + hingeOffsetY;
>     b.y = u.y - hingeOffsetY;
>     transformsPoint( (Transform3D[]) transformO, a);
>     transformsPoint( (Transform3D[]) transformO, b);
>     drawing.addFeature(featureName, a, why);
>     drawing.addFeature(featureName, b, why);
>     insert(new QualityEntry(pparent, "DOORFRAME LATCH X", a.x - center.x ,3,202));
>   }

>   if (!inside) {
>        insert(new QualityEntry(pparent, "NOTEGA", "Hemmed flat material must be 20ga or thicker",99));
>   }


>   if (!inside) {
>        // we need to add some more flats to complete this drawing
>        // c channel vertical (qty 2), c channel h (qty 2)
>        // height needs to include general.doorframe.hole.to.open * 2 
>        Point3d dbl = new Point3d();
>        Point3d dbu = new Point3d();
>        doorBounds.getLower(dbl);
>        doorBounds.getUpper(dbu);
>        dbl.y -= openOffset;
>        dbu.y += openOffset;
>        BoundingBox channelBounds = new BoundingBox(dbl, dbu);
>        insert(new RuleLink("AddDoorFrameFlatsV2", pparent, channelBounds));

>    }
end


















// set Y2=0 to avoid a X or Y offset test
// change hole from 1 to 1.72
// don't add rivnuts etc if they already exist
rule "manufacturing.panel.v2.drawings.electricalbox.terminalstrip.20210820.01"
when
     drawing matches "panel.v2.flat.*"
>    ManufacturingFeature(  featurename: name matches "feature.electricalboxterminal.*",  vBounds: value,    pparent: parent)
>                RuleLink(  name matches  "drawingToParentFlat.(inside|outside)",  a == drawing,  b == pparent )
>                RuleLink(  name == "drawingToTransformLink", a == drawing, transformO : b)

>    ManufacturingFeature(  name ==  "general.bounds",  bounds: value  ,     parent == pparent)
>    ManufacturingFeature(  name ==  "general.dim.a.axis",  aAxis: value,    parent == pparent)
>    ManufacturingFeature(  name ==  "general.dim.b.axis",  bAxis: value,    parent == pparent)
> //   ManufacturingFeature(  name ==  "general.orientation"   , orientation: value,    parent == pparent)

then
>   BoundingBox box = BoundingBoxUtil.convertStringToBox(vBounds);
>   Point3d l = new Point3d();
>   Point3d u = new Point3d();
>   box.getLower(l);
>   box.getUpper(u);

>   boolean isSide = (aAxis.contains("X") || bAxis.contains("X")) ;


> // move this to intersector???
>   boolean skipPattern = false;
>   Point3d ll = new Point3d(l);
>   ll.x -= .1;
>   ll.y -= .1;
>   ll.z -= .1;
>   Point3d uu = new Point3d(u);
>   uu.x += .1;
>   uu.y += .1;
>   uu.z += .1;
>   BoundingBox rivnutBlockBounds = new BoundingBox(ll,uu); // if we find a rivnut in this bounds (add .1 to ensure intersection between box and rivnuts), don't add the pattern

>   BoundingBox rivB;
>   for (ManufacturingFeature f : pparent.getFeatures()) {
>     if (f.getName().startsWith("feature.rivnut")) {
>       rivB =  BoundingBoxUtil.convertStringToBox(f.getValue());
>       if (rivnutBlockBounds.intersect(rivB)) {
>          skipPattern = true;
>          break;
>       }
>     }
>   }

> if (!skipPattern) {

>   BoundingBox panelBounds = BoundingBoxUtil.convertStringToBox(bounds);
>   Point3d pl = new Point3d();
>   Point3d pu = new Point3d();
>   panelBounds.getLower(pl);
>   panelBounds.getUpper(pu);


>   Point3d centerPanelT = BoundingBoxUtil.getCenter(panelBounds);
>   transformsPoint( (Transform3D[]) transformO, centerPanelT);

>   Point3d centerBoxT = BoundingBoxUtil.getCenter(box);
>   Point3d centerBoxU = new Point3d(centerBoxT);
>   transformsPoint( (Transform3D[]) transformO, centerBoxT);

> // ASSUMES but does not validate TZ =1

>   String why = drools.getRule().getName();
>   final double XONE = 10; // Ed Email on Sep 10 2010  From 39ma51001406_drw.pdf Rev C.6
>   final double YONE = 10; // Ed Email on Sep 10 2010  From 39ma51001406_drw.pdf Rev C.6
>   final double YTWO = 0; // zero to make the x and y orientation easier
>   final double HALFHEIGHT = (YONE) / 2.0; 

>   final double YCONDUIT = 2.02; // From 39ma51001406_drw.pdf Rev C.6
>   final double CONDUITRADIUS = 1.72 / 2.0; // internal to box conduit hole radius From 39ma51001406_drw.pdf Rev C.6
>   final String conduitQC = makeConduitName(CONDUITRADIUS*2.0);
>   final double RADIUS = .4 / 2.0;

> // System.out.println("terminal strip offset = " + offset);
> // 4 holes always on one surface defined by the feature name
> // 1 conduit hole on both flats when box mounted on outside of unit

>  boolean featureInside = featurename.contains("inside");
>  boolean featureOutside = featurename.contains("outside");
>  boolean drawingInside =  drawing.getDrawingName().contains("inside");
>  boolean drawingOutside =  drawing.getDrawingName().contains("outside");

>   if (
>         (featureInside && drawingInside) ||
>         (featureOutside && drawingOutside)
>       ) {
>        //    System.out.println("Adding circles to " + featurename + " " + drawing.getDrawingName());
> //  System.out.println("box terminal offset " + offset);
>            double centerY = centerBoxU.y;

>            Point3d[]  pSide = { new Point3d(centerBoxU.x - (XONE/2.0), centerY+ (YONE/2.0), centerBoxU.z),
>                    new Point3d(centerBoxU.x + (XONE/2.0), centerY+ (YONE/2.0), centerBoxU.z),
>                    new Point3d(centerBoxU.x - (XONE/2.0), centerY- (YONE/2.0), centerBoxU.z),
>                    new Point3d(centerBoxU.x + (XONE/2.0), centerY- (YONE/2.0), centerBoxU.z),
>                  };
>            Point3d[]  pEnd = { new Point3d(centerBoxU.x , centerY+ (YONE/2.0), centerBoxU.z- (XONE/2.0)),
>                    new Point3d(centerBoxU.x , centerY+ (YONE/2.0), centerBoxU.z+ (XONE/2.0)),
>                    new Point3d(centerBoxU.x , centerY- (YONE/2.0), centerBoxU.z- (XONE/2.0)),
>                    new Point3d(centerBoxU.x , centerY- (YONE/2.0), centerBoxU.z+ (XONE/2.0)),
>                  };
>            Point3d[] p = (isSide) ? pSide : pEnd;
>            String rivnut = (featureOutside) ? "RIVNUTF" : "RIVNUTNF";
>            String pt;
>            for (int ndx=0; ndx < p.length; ndx++) {
>               System.out.println("Terminal Pre Transform " + p[ndx]);
>               transformsPoint( (Transform3D[]) transformO, p[ndx]);
>               System.out.println("Terminal Post Transform " + p[ndx]);
>               p[ndx].z = 0;
>               pt = qCFormatXY(drawing,  p[ndx] );
>               insert(new QualityEntry(pparent, rivnut, pt,200));
>               drawing.addCircle(p[ndx] , RADIUS,why);
>            }
>   }

>  // add 
>   if (featureOutside )  {
>      double conduitY =  centerBoxU.y - (YONE/2.0) - YCONDUIT;
>      Point3d conduitP = new Point3d(centerBoxU.x, conduitY, centerBoxU.z);
>      transformsPoint( (Transform3D[]) transformO, conduitP);
>      if (drawingOutside) {
>        String pt = qCFormatXY(drawing,  conduitP );
>        insert(new QualityEntry(pparent, conduitQC , pt,200));
>      }
>      conduitP.z = 0;
>      drawing.addCircle(conduitP , CONDUITRADIUS,why);
>   }

> } // skipPattern
end








// this rule is also duplicated in intersector for perf impact

rule "manufacturing.panel.v2.drawings.penetration.pattern.pdisco.20121127.01"
//
//  This rule creates the penetration in the outside skin by pattern
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
>         ManufacturingFeature( name == "penetration.pattern",  raw : value matches ".*PDISCO[123].*" , parent == pparent  )
>         ManufacturingFeature( name == "general.bounds",  bounds: value  ,     parent == pparent)
>         ManufacturingFeature( name == "general.dim.a.axis",  aAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.dim.b.axis",  bAxis: value,    parent == pparent)
>         ManufacturingFeature( name == "general.orientation"  , orientation: value, parent == pparent)

>         RuleLink( name ==  "drawingToParentFlat.outside",  drawingO: a,  b == pparent  )
>         RuleLink( name ==  "drawingToParentFlat.inside",  drawingInsideO: a,  b == pparent  )
then
>   System.out.println("Start processing pattern " + raw);
>   Drawing flat = (Drawing) drawingO;

>   String[] parts = raw.split("\\t");
>   double[] partsd = new double[parts.length];
>   for (int ndx=0; ndx < parts.length; ndx++) { 
>      try {
>         partsd[ndx] = Double.parseDouble(parts[ndx]);
>      } catch (java.lang.NumberFormatException nfe) {
>        //eat it, just eat it, it is expected on KEY and PATTERN
>      }
>   }
>   final int X = 0;
>   final int Y = 1;
>   final int KEY =2;
>   final int PATTERN =3;
>   final int X1 =4;
>   final int Y1 =5;
>   final int Y2 =6;
>   final int D =7;
>   final int TZ = 8;
>   final int A = 9;
>   final int X3 = 10;
>   if (parts.length < 11) {
>      throw new Exception("Failed to split raw into 10 parts " + raw + " " + parts.length);
>   }

>   Point3d offset = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flat);
>   System.out.println("OFFSET for pattern is " + offset);

>  // Only A needs to be inverted for INVERTA orientations
>   if (orientation.equals("INVERTA")) {
>      partsd[A] *= -1.0;
>   }


>   double hx1 = partsd[X1] /2.0;
>   final double RADIUS = .2; // for a .4 diameter hole
>   String why = drools.getRule().getName();

> // setup inside skin
>   Drawing flatIn = (Drawing) drawingInsideO;
>   Point3d offsetIn = calculateFeatureOffset(aAxis, bAxis,
>             new Point3d(partsd[X], partsd[Y], 0),
>             BoundingBoxUtil.getCenter(BoundingBoxUtil.convertStringToBox(bounds)),
>             flatIn);
>   System.out.println("OFFSETInside  for pattern is " + offsetIn);


>   if (parts[PATTERN].contains("3")) {// figure 3 has a different pattern
>     double x3 = partsd[X3];
>     // pattern 3 has 9 holes
>     flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx1 - x3           , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1 + x3           , offset.y -partsd[TZ],0)            , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx1 - x3           , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1 + x3           , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + partsd[A]             , offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/ 2.0,why);
>     flatIn.addCircle(new Point3d(offsetIn.x + partsd[A]             , offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/ 2.0,why);
>   } else {
>     // patterns 1 and 2 are 5 holes
>     flat.addCircle(new Point3d(offset.x - hx1, offset.y -partsd[TZ],0)           , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1, offset.y -partsd[TZ],0)           , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx1, offset.y -partsd[TZ]-partsd[Y1],0), RADIUS,why);
>     flat.addCircle(new Point3d(offset.x + hx1, offset.y -partsd[TZ]-partsd[Y1],0), RADIUS,why);
>     flat.addCircle(new Point3d(offset.x, offset.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/2.0,why);
>     flatIn.addCircle(new Point3d(offsetIn.x, offsetIn.y -partsd[TZ]-partsd[Y1]-partsd[Y2],0), partsd[D]/2.0,why);
>   }


>   Point3d origin =  flat.getFeature("ORG_ANC_LL").getHandle();
>   String pt = "X=" +  Rounding.roundToPrettyString(offset.x - origin.x, 3) + "  Y=" + Rounding.roundToPrettyString(offset.y-origin.y, 3)  ;
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".001", pt ,150));
>   String key = "TZ=" +partsd[TZ] + " X1="+ partsd[X1];  
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".002", key ,151));
>   key = "Y1="+ partsd[Y1]+ " Y2="+ partsd[Y2]+ " D="+ partsd[D]+ " A="+ partsd[A];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".003", key ,152));
>   key = "X3="+ partsd[X3];
>   insert(new QualityEntry(pparent, parts[PATTERN] + ".004", key ,153));

end


rule "manufacturing.panel.v2.drawings.penetration.pattern.vfd.bypass.20121127.01"
//
//  This rule creates the penetration in the outside skin by pattern
//
when
>   p:    ManufacturingFeature( name == "general.classification", value == "PANEL.V2", pparent : parent )
