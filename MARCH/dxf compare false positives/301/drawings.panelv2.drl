rule "manufacturing.panel.v2.spacer.20171222.01"
when
>    p:            ManufacturingFeature( name == "general.classification" , value == "PANEL.V2",  pparent : parent )
>    s:            ManufacturingFeature( name == "general.flange.spacer" , value == "YES",   parent == pparent )
then
>     s.incrementUsage();
>     insert(new QualityEntry(pparent, "NOTEH", "HEM SPACER REQUIRED",6));
end




