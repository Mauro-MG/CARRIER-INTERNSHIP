>     flat.addCircle(new Point3d(offset.x - hx1                   , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
>     flat.addCircle(new Point3d(offset.x - hx1 - x3           , offset.y -partsd[TZ]-partsd[Y1],0) , RADIUS,why);
