     add row to data  "[GHQR][DJ][BG]~.*~" "MOTORBOX~F2~FfcsDnoLsideDD[du]bfHsidethis f2 "
     add row to data  "[GHQR][DJ][DJ]~.*~" "MOTORBOX~F1~FfcsDnoLsideDD[du]bfHsideopposite f1 "
     add row to data  "[GHQR][FK][BG]~.*~" "MOTORBOX~F1~FfcsDnoLsideDD[du]brHsidethis f1 "
     add row to data  "[GHQR][FK][DJ]~.*~" "MOTORBOX~F2~FfcsDnoLsideDD[du]brHsideopposite f2 "
     add row to data  "..[13]~.*~" "MOTORBOX~F1~Specified in 39MB part number"
     add row to data  "..[24]~.*~" "MOTORBOX~F2~Specified in 39MB part number"
   processLauRawRequiredFanRule
end



rule "pricing.fansled.v1.xls.sourced.D.1213.20260806"
when
   fansledLauRawRule
   store fansled hit P14 as p14
then
   LauFanSetup
   set key to p14
   set data to 
     add row to data  "[0123456789]" "EXTRABELTS~NO~No Extra Belts"
     add row to data  "[-ZYXWVTSRQ]" "EXTRABELTS~YES~Extra Belts"
   processLauRawRequiredFanRule
end



rule "pricing.fansled.v1.xls.sourced.D.1217.20260806"
when
   fansledLauRawRule
   store fansled hit P17 as p17
   store fansled hit NOMENCLATURE as nomenclature restriction != "DDPF"
then
   LauFanSetup
   set key to p17
   set data to 
     add row to data  "[BCDF12]" "MOTORFIELDSUPPLIED~NO~Motor Factory Supplied"
     add row to data  "[GHJK34]" "MOTORFIELDSUPPLIED~YES~Motor Field Supplied"
   processLauRawRequiredFanRule
end



rule "pricing.fansled.v1.xls.sourced.motordetails.D.1234.20260806"
when
   fansledLookupRule
   store fansled hit MOTORBOX as motorbox
   store fansled hit SHAFTGROUNDING as shaftgrounding
   store fansled hit MOTORBASECODE as motorbasecode
then
   set key to "MOTORDETAILS:"+"~"+motorbox+"~"+shaftgrounding+"~"+motorbasecode+"~"
   useFanLookupFile
   processLookupFanRule
end



